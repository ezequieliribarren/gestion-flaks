<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %>Flaks Gestión</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'ui-sans-serif', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eef4ff', 100: '#d9e6ff', 200: '#bcd2ff', 300: '#8eb3ff',
              400: '#598dfc', 500: '#3466f0', 600: '#204ddb', 700: '#1b3db5', 800: '#1c398f', 900: '#1c3475',
            },
          },
          boxShadow: {
            card: '0 0 0 1px rgb(15 23 42 / 0.04), 0 1px 2px 0 rgb(15 23 42 / 0.04), 0 8px 24px -8px rgb(15 23 42 / 0.10)',
            'card-hover': '0 0 0 1px rgb(32 77 219 / 0.10), 0 2px 6px 0 rgb(15 23 42 / 0.06), 0 16px 36px -10px rgb(15 23 42 / 0.20)',
          },
        },
      },
    };
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📋</text></svg>" />
  <style>
    :root { color-scheme: light; }
    body {
      font-feature-settings: 'cv11', 'ss01';
      -webkit-font-smoothing: antialiased;
      background-color: #f1f5f9;
      background-image:
        radial-gradient(900px 500px at 100% -5%, rgba(52,102,240,.10), transparent 60%),
        radial-gradient(700px 500px at -10% 110%, rgba(52,102,240,.07), transparent 55%);
      background-attachment: fixed;
    }

    .sidebar {
      background: linear-gradient(180deg, #0b1220 0%, #0f172a 55%, #131c31 100%);
    }
    .nav-link { position: relative; transition: background-color .15s ease, color .15s ease; }
    .nav-link.is-active {
      background: linear-gradient(90deg, rgba(52,102,240,.30), rgba(52,102,240,.08));
      color: #fff;
    }
    .nav-link.is-active::before {
      content: ''; position: absolute; left: -8px; top: 8px; bottom: 8px; width: 3px;
      border-radius: 999px; background: #598dfc;
    }
    .brand-mark {
      background: linear-gradient(135deg, #3466f0, #598dfc);
      box-shadow: 0 6px 16px -4px rgba(52,102,240,.6);
    }

    @keyframes fadeInUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    @keyframes toastIn { from { opacity: 0; transform: translateY(-14px) scale(.96); } to { opacity: 1; transform: none; } }
    @keyframes toastOut { to { opacity: 0; transform: translateY(-10px) scale(.97); } }
    @keyframes checkPop { 0% { transform: scale(0); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }
    @keyframes barShrink { from { transform: scaleX(1); } to { transform: scaleX(0); } }
    @keyframes rowFlash { 0% { background-color: rgb(220 252 231); } 100% { background-color: transparent; } }

    .page-enter { animation: fadeInUp .28s cubic-bezier(.22,.61,.36,1) both; }

    .toast { animation: toastIn .32s cubic-bezier(.22,1.2,.36,1) both; }
    .toast.hide { animation: toastOut .25s ease forwards; }
    .toast-bar { transform-origin: left; animation: barShrink 3.6s linear forwards; }
    .toast-check { animation: checkPop .4s cubic-bezier(.22,1.4,.36,1) .05s both; }

    /* filas tipo planilla: una blanca, la siguiente gris muy suave */
    .zebra > tbody > tr:nth-child(odd) { background-color: #ffffff; }
    .zebra > tbody > tr:nth-child(even) { background-color: #f8fafc; }
    .zebra > tbody > tr { transition: background-color .12s ease; }
    .zebra > tbody > tr:hover { background-color: #eef4ff; }
    .zebra > tbody > tr.pendiente,
    .zebra > tbody > tr.pendiente:nth-child(even) { background-color: #fef9ec; }
    .zebra > tbody > tr.pendiente:hover { background-color: #fdf0cf; }
    .row-new { animation: rowFlash 1.6s ease-out both; }

    .lift { transition: transform .18s ease, box-shadow .18s ease; }
    .lift:hover { transform: translateY(-2px); }

    .btn { transition: transform .12s ease, background-color .15s ease, box-shadow .15s ease; }
    .btn:active { transform: scale(.97); }

    .nav-link { transition: background-color .15s ease, color .15s ease, border-color .15s ease; }

    @media (max-width: 640px) {
      h1 { font-size: 1.35rem; line-height: 1.9rem; }
      input:not([type="checkbox"]):not([type="radio"]), textarea { font-size: 16px; } /* evita el zoom de iOS al enfocar */
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen font-sans">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="sidebar hidden md:flex md:flex-col w-60 text-slate-300 shrink-0">
      <div class="px-5 py-5 flex items-center gap-3">
        <span class="brand-mark w-9 h-9 rounded-xl flex items-center justify-center text-white font-bold text-lg">F</span>
        <div>
          <div class="text-base font-bold text-white tracking-tight leading-none">Flaks</div>
          <div class="text-[11px] text-slate-400 mt-0.5">Gestión interna</div>
        </div>
      </div>
      <nav class="flex-1 py-2 space-y-1 px-3">
        <% const nav = esAdmin ? [
          ['/tareas', 'Tareas', '📝'],
          ['/contenido', 'Contenido', '📸'],
          ['/clientes', 'Clientes', '👥'],
          ['/facturacion', 'Facturación', '💰'],
          ['/gastos', 'Gastos', '🧾'],
          ['/caja', 'Caja', '📊'],
          ['/documentos', 'Documentos', '📁'],
        ] : [
          ['/contenido', 'Contenido', '📸'],
        ]; %>
        <% nav.forEach(function(item){ const activo = currentPath.indexOf(item[0]) === 0; %>
          <a href="<%= item[0] %>" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm <%= activo ? 'is-active' : 'hover:bg-white/5 hover:text-white' %>">
            <span class="text-base leading-none"><%= item[2] %></span><span><%= item[1] %></span>
          </a>
        <% }); %>
      </nav>
      <div class="px-4 py-4 mx-3 mb-3 rounded-xl bg-white/5 text-xs">
        <div class="mb-2 text-slate-400">Sesión: <span class="text-white font-medium"><%= currentUser ? currentUser.nombre : '' %></span></div>
        <form method="POST" action="/logout"><button class="btn text-brand-300 hover:text-brand-200 font-medium">Cerrar sesión</button></form>
      </div>
    </aside>

    <!-- Contenido -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Header móvil -->
      <header class="sidebar md:hidden text-white flex items-center justify-between px-4 py-3 sticky top-0 z-20">
        <span class="flex items-center gap-2 font-bold">
          <span class="brand-mark w-7 h-7 rounded-lg flex items-center justify-center text-sm">F</span> Flaks
        </span>
        <span class="text-xs text-slate-300 flex items-center gap-3">
          <a href="/notificaciones" class="relative text-lg leading-none" aria-label="Notificaciones">🔔<% if (notifCount > 0) { %><span class="absolute -top-1.5 -right-2 bg-red-500 text-white text-[9px] font-bold rounded-full min-w-[15px] h-[15px] px-1 flex items-center justify-center"><%= notifCount > 9 ? '9+' : notifCount %></span><% } %></a>
          <%= currentUser ? currentUser.nombre : '' %>
          <form method="POST" action="/logout"><button class="text-brand-300">Salir</button></form>
        </span>
      </header>

      <!-- Barra superior (desktop) -->
      <div class="hidden md:flex items-center justify-end gap-4 px-8 pt-5">
        <a href="/notificaciones" class="relative text-slate-500 hover:text-slate-800 text-xl leading-none" aria-label="Notificaciones">
          🔔<% if (notifCount > 0) { %><span class="absolute -top-1.5 -right-2 bg-red-500 text-white text-[10px] font-bold rounded-full min-w-[16px] h-[16px] px-1 flex items-center justify-center"><%= notifCount > 9 ? '9+' : notifCount %></span><% } %>
        </a>
      </div>

      <main class="flex-1 px-3 py-4 sm:px-8 sm:pt-4 sm:pb-8 <%= nav.length > 1 ? 'pb-24' : 'pb-8' %> md:pb-8 max-w-6xl w-full mx-auto">
        <div class="page-enter">
          <%- body %>
        </div>
      </main>
      <footer class="hidden md:block text-center text-xs text-slate-400 py-5">Flaks Gestión · uso interno</footer>
    </div>
  </div>

  <!-- Barra de navegación inferior (mobile) -->
  <% if (nav.length > 1) { %>
  <nav class="md:hidden fixed bottom-0 inset-x-0 z-30 bg-white border-t border-slate-200 grid pb-[env(safe-area-inset-bottom)]"
       style="grid-template-columns: repeat(<%= nav.length %>, minmax(0, 1fr));">
    <% nav.forEach(function(item){ const activo = currentPath.indexOf(item[0]) === 0; %>
      <a href="<%= item[0] %>" class="flex flex-col items-center justify-center gap-0.5 py-2 text-[10px] <%= activo ? 'text-brand-600' : 'text-slate-400' %>">
        <span class="text-lg leading-none"><%= item[2] %></span>
        <span class="leading-none"><%= item[1] %></span>
      </a>
    <% }); %>
  </nav>
  <% } %>

  <!-- Toast (flash) -->
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div id="toast" class="toast fixed top-16 sm:top-4 right-3 left-3 sm:left-auto z-50 sm:w-96">
      <div class="relative overflow-hidden rounded-xl shadow-card border <%= flash.tipo === 'error' ? 'bg-white border-red-200' : 'bg-white border-green-200' %>">
        <div class="flex items-start gap-3 p-4">
          <% if (flash.tipo === 'error') { %>
            <span class="shrink-0 mt-0.5 w-6 h-6 rounded-full bg-red-100 text-red-600 flex items-center justify-center font-bold">!</span>
          <% } else { %>
            <span class="toast-check shrink-0 mt-0.5 w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center">
              <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.79a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
            </span>
          <% } %>
          <div class="text-sm text-slate-700 flex-1"><%= flash.msg %></div>
          <button onclick="document.getElementById('toast').classList.add('hide')" class="shrink-0 text-slate-400 hover:text-slate-600 text-lg leading-none">&times;</button>
        </div>
        <div class="toast-bar h-0.5 <%= flash.tipo === 'error' ? 'bg-red-400' : 'bg-green-400' %>"></div>
      </div>
    </div>
    <script>
      (function () {
        var t = document.getElementById('toast');
        if (!t) return;
        var kill = function () { t.classList.add('hide'); setTimeout(function () { t.remove(); }, 300); };
        setTimeout(kill, 3600);
        t.addEventListener('click', function (e) { if (e.target.tagName !== 'A') kill(); });
      })();
    </script>
  <% } %>
</body>
</html>
