<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %>Flaks Gestión</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'ui-sans-serif', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eefdf6', 100: '#d5fbe6', 200: '#a8f4cd', 300: '#71e8a8',
              400: '#3ad683', 500: '#16c169', 600: '#0da057', 700: '#0a8047', 800: '#0c663a', 900: '#0b5330',
            },
          },
          boxShadow: {
            card: '0 0 0 1px rgb(15 23 42 / 0.04), 0 1px 2px 0 rgb(15 23 42 / 0.04), 0 8px 24px -8px rgb(15 23 42 / 0.10)',
            'card-hover': '0 0 0 1px rgb(13 160 87 / 0.12), 0 2px 6px 0 rgb(15 23 42 / 0.06), 0 16px 36px -10px rgb(15 23 42 / 0.20)',
          },
        },
      },
    };
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" href="/public/LOGO.png" />
  <style>
    :root { color-scheme: light; }
    body {
      font-feature-settings: 'cv11', 'ss01';
      -webkit-font-smoothing: antialiased;
      background-color: #f1f5f9;
      background-image:
        radial-gradient(900px 500px at 100% -5%, rgba(52,102,240,.10), transparent 60%),
        radial-gradient(700px 500px at -10% 110%, rgba(52,102,240,.07), transparent 55%);
      background-attachment: fixed;
    }

    .sidebar {
      background: linear-gradient(180deg, #0b1220 0%, #0f172a 55%, #131c31 100%);
    }
    .nav-link { position: relative; transition: background-color .15s ease, color .15s ease; }
    .nav-link.is-active {
      background: linear-gradient(90deg, rgba(22,193,105,.30), rgba(22,193,105,.08));
      color: #fff;
    }
    .nav-link.is-active::before {
      content: ''; position: absolute; left: -8px; top: 8px; bottom: 8px; width: 3px;
      border-radius: 999px; background: #3ad683;
    }
    .nav-link svg { width: 1.1rem; height: 1.1rem; }
    .brand-mark {
      box-shadow: 0 6px 16px -4px rgba(13,160,87,.5);
      object-fit: cover;
    }

    @keyframes fadeInUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    @keyframes toastIn { from { opacity: 0; transform: translateY(-14px) scale(.96); } to { opacity: 1; transform: none; } }
    @keyframes toastOut { to { opacity: 0; transform: translateY(-10px) scale(.97); } }
    @keyframes checkPop { 0% { transform: scale(0); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }
    @keyframes barShrink { from { transform: scaleX(1); } to { transform: scaleX(0); } }
    @keyframes rowFlash { 0% { background-color: rgb(220 252 231); } 100% { background-color: transparent; } }

    .page-enter { animation: fadeInUp .28s cubic-bezier(.22,.61,.36,1) both; }

    .toast { animation: toastIn .32s cubic-bezier(.22,1.2,.36,1) both; }
    .toast.hide { animation: toastOut .25s ease forwards; }
    .toast-bar { transform-origin: left; animation: barShrink 3.6s linear forwards; }
    .toast-check { animation: checkPop .4s cubic-bezier(.22,1.4,.36,1) .05s both; }

    /* filas tipo planilla: una blanca, la siguiente gris muy suave */
    .zebra > tbody > tr:nth-child(odd) { background-color: #ffffff; }
    .zebra > tbody > tr:nth-child(even) { background-color: #f8fafc; }
    .zebra > tbody > tr { transition: background-color .12s ease; }
    .zebra > tbody > tr:hover { background-color: #eef4ff; }
    .zebra > tbody > tr.pendiente,
    .zebra > tbody > tr.pendiente:nth-child(even) { background-color: #fef9ec; }
    .zebra > tbody > tr.pendiente:hover { background-color: #fdf0cf; }
    .row-new { animation: rowFlash 1.6s ease-out both; }

    .lift { transition: transform .18s ease, box-shadow .18s ease; }
    .lift:hover { transform: translateY(-2px); }

    .btn { transition: transform .12s ease, background-color .15s ease, box-shadow .15s ease; }
    .btn:active { transform: scale(.97); }

    .nav-link { transition: background-color .15s ease, color .15s ease, border-color .15s ease; }

    /* --- Toques "menos cuadrado": esquinas más suaves, feedback al clickear, foco moderno --- */
    /* Sube el radio por default de los botones/inputs sueltos que sólo usan la clase base
       "rounded" de Tailwind (0.25rem), sin tocar los que ya piden un radio explícito mayor. */
    .rounded { border-radius: .5rem !important; }

    button, .btn, a.btn, select, input[type="button"], input[type="submit"] {
      transition: transform .12s ease, background-color .15s ease, box-shadow .15s ease, border-color .15s ease, opacity .15s ease;
    }
    button:active:not(:disabled), .btn:active, a.btn:active { transform: scale(.96); }
    button:disabled { cursor: not-allowed; opacity: .6; }

    input:not([type="checkbox"]):not([type="radio"]), select, textarea {
      transition: box-shadow .15s ease, border-color .15s ease;
    }
    input:not([type="checkbox"]):not([type="radio"]):focus, select:focus, textarea:focus {
      outline: none;
      border-color: #3ad683;
      box-shadow: 0 0 0 3px rgba(22,193,105,.15);
    }
    input[type="checkbox"], input[type="radio"] { accent-color: #0da057; }

    /* Filas de tablas "planas" (no .zebra, como las de la ficha de cliente): resalte suave al pasar el mouse. */
    table:not(.zebra) tbody tr { transition: background-color .12s ease; }
    table:not(.zebra) tbody tr:hover { background-color: #f8fafc; }

    /* Edición inline en tablas: los campos no se ven como "cajas" hasta que se los toca,
       para que la tabla se sienta más limpia y menos recargada. */
    table:not(.zebra) input:not([type="checkbox"]), table:not(.zebra) select {
      border-color: transparent; background-color: transparent;
    }
    table:not(.zebra) input:not([type="checkbox"]):hover, table:not(.zebra) select:hover {
      border-color: #e2e8f0; background-color: #fff;
    }
    table:not(.zebra) input:not([type="checkbox"]):focus, table:not(.zebra) select:focus {
      background-color: #fff;
    }
    /* Tabla + su contenedor con scroll: un solo marco prolijo en vez de sensación de "flotar". */
    .overflow-x-auto:has(> table:not(.zebra)) {
      border: 1px solid #e2e8f0; border-radius: .75rem;
    }
    table:not(.zebra) thead { background: #f8fafc; }

    /* Paneles: leve profundidad extra al pasar el mouse, sin moverlos (para no "saltar" en tablas grandes). */
    .shadow-card { transition: box-shadow .18s ease; }

    @media (max-width: 640px) {
      h1 { font-size: 1.35rem; line-height: 1.9rem; }
      input:not([type="checkbox"]):not([type="radio"]), textarea { font-size: 16px; } /* evita el zoom de iOS al enfocar */
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen font-sans">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="sidebar hidden md:flex md:flex-col w-60 text-slate-300 shrink-0">
      <div class="px-5 py-5 flex items-center gap-3">
        <img src="/public/LOGO.png" alt="Flaks" class="brand-mark w-9 h-9 rounded-xl" />
        <div>
          <div class="text-base font-bold text-white tracking-tight leading-none">Flaks</div>
          <div class="text-[11px] text-slate-400 mt-0.5">Gestión interna</div>
        </div>
      </div>
      <%
        // Íconos minimalistas (trazo, sin relleno) en vez de emoji.
        function icono(name, size) {
          var attrs = 'width="' + (size || 18) + '" height="' + (size || 18) + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
          var paths = {
            bell: '<path d="M6 10a6 6 0 0 1 12 0c0 4 1.2 5.5 1.8 6.2a.8.8 0 0 1-.6 1.3H4.8a.8.8 0 0 1-.6-1.3C4.8 15.5 6 14 6 10Z"/><path d="M10 20a2 2 0 0 0 4 0"/>',
            home: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9a1 1 0 0 0 1 1H9.5a1 1 0 0 0 1-1v-4.5h3V19a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-9"/>',
            tasks: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 3.5h6a1 1 0 0 1 1 1V6h-8V4.5a1 1 0 0 1 1-1Z"/><path d="M8.5 12h7M8.5 15.5h5"/>',
            building: '<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 7h1.5M8 10.5h1.5M8 14h1.5M14.5 7H16M14.5 10.5H16M14.5 14H16"/><path d="M10 21v-3.5a2 2 0 0 1 4 0V21"/>',
            users: '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 14c2.6.3 4.7 2.4 4.9 5.1"/>',
            camera: '<path d="M4 8.5a1.5 1.5 0 0 1 1.5-1.5h2l1-1.7A1 1 0 0 1 9.4 4.7h5.2a1 1 0 0 1 .9.6L16.5 7h2A1.5 1.5 0 0 1 20 8.5V18a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18Z"/><circle cx="12" cy="13" r="3.2"/>',
            megaphone: '<path d="M3 10v4a1 1 0 0 0 1 1h2l1.5 4.5a1 1 0 0 0 1 .7H10V10"/><path d="M7 10 17 5.5a.7.7 0 0 1 1 .6v11.8a.7.7 0 0 1-1 .6L7 14"/><path d="M18 9.5c1 .6 1 4.4 0 5"/>',
            chart: '<path d="M4 20V10M10 20V4M16 20v-7M4 20h16"/>',
            receipt: '<path d="M6 4h12v16l-2-1.2-2 1.2-2-1.2-2 1.2-2-1.2-2 1.2Z"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4"/>',
            tag: '<path d="M11.5 4h5A1.5 1.5 0 0 1 18 5.5v5a1.5 1.5 0 0 1-.44 1.06l-8 8a1.5 1.5 0 0 1-2.12 0l-4-4a1.5 1.5 0 0 1 0-2.12l8-8A1.5 1.5 0 0 1 11.5 4Z"/><circle cx="14.5" cy="8.5" r="1.1"/>',
            wallet: '<rect x="3.5" y="6" width="17" height="12" rx="2"/><path d="M3.5 10h17"/><circle cx="16.5" cy="14" r="1"/>',
            folder: '<path d="M4 6.5A1.5 1.5 0 0 1 5.5 5H10l1.6 2H18.5A1.5 1.5 0 0 1 20 8.5v9A1.5 1.5 0 0 1 18.5 19h-13A1.5 1.5 0 0 1 4 17.5Z"/>',
          };
          return '<svg ' + attrs + '>' + (paths[name] || '') + '</svg>';
        }
        // Grupos del menú. { href|null, label, icon, hijos:[[href,label,icon]] }
        const navGrupos = esAdmin ? [
          { href: '/inicio', label: 'Inicio', icon: 'home', hijos: [] },
          { href: '/tareas', label: 'Tareas', icon: 'tasks', hijos: [['/tareas/flaks', 'FLAKS', 'building']] },
          { href: '/clientes', label: 'Clientes', icon: 'users', hijos: [['/contenido', 'Contenido', 'camera'], ['/marketing', 'Marketing', 'megaphone']] },
          { href: null, label: 'Administración', icon: 'chart', hijos: [['/facturacion', 'Facturación', 'receipt'], ['/gastos', 'Gastos', 'tag'], ['/caja', 'Caja', 'wallet']] },
          { href: '/documentos', label: 'Documentos', icon: 'folder', hijos: [] },
        ] : [
          { href: '/contenido', label: 'Contenido', icon: 'camera', hijos: [] },
        ];
        // lista plana para la barra inferior (mobile)
        const navFlat = esAdmin
          ? [['/inicio', 'Inicio', 'home'], ['/tareas', 'Tareas', 'tasks'], ['/clientes', 'Clientes', 'users'], ['/contenido', 'Contenido', 'camera'], ['/facturacion', 'Admin', 'chart'], ['/documentos', 'Docs', 'folder']]
          : [['/contenido', 'Contenido', 'camera']];
        function _act(h) { return h === '/tareas' ? currentPath === '/tareas' : currentPath.indexOf(h) === 0; }
      %>
      <nav class="flex-1 py-2 space-y-0.5 px-3 overflow-y-auto">
        <% navGrupos.forEach(function(g){ %>
          <% if (g.href) { %>
            <a href="<%= g.href %>" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm <%= _act(g.href) ? 'is-active' : 'hover:bg-white/5 hover:text-white' %>">
              <span class="leading-none shrink-0"><%- icono(g.icon) %></span><span><%= g.label %></span>
            </a>
          <% } else { %>
            <div class="flex items-center gap-3 px-3 pt-3 pb-1 text-[11px] uppercase tracking-wide text-slate-500"><span class="leading-none shrink-0"><%- icono(g.icon) %></span><span><%= g.label %></span></div>
          <% } %>
          <% g.hijos.forEach(function(h){ %>
            <a href="<%= h[0] %>" class="nav-link flex items-center gap-3 pl-9 pr-3 py-2 rounded-xl text-sm <%= _act(h[0]) ? 'is-active' : 'text-slate-400 hover:bg-white/5 hover:text-white' %>">
              <span class="leading-none shrink-0"><%- icono(h[2]) %></span><span><%= h[1] %></span>
            </a>
          <% }); %>
        <% }); %>
      </nav>
      <div class="px-4 py-4 mx-3 mb-3 rounded-xl bg-white/5 text-xs">
        <div class="mb-2 text-slate-400">Sesión: <span class="text-white font-medium"><%= currentUser ? currentUser.nombre : '' %></span></div>
        <form method="POST" action="/logout"><button class="btn text-brand-300 hover:text-brand-200 font-medium">Cerrar sesión</button></form>
      </div>
    </aside>

    <!-- Contenido -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Header móvil -->
      <header class="sidebar md:hidden text-white flex items-center justify-between px-4 py-3 sticky top-0 z-20">
        <span class="flex items-center gap-2 font-bold">
          <img src="/public/LOGO.png" alt="Flaks" class="brand-mark w-7 h-7 rounded-lg" /> Flaks
        </span>
        <span class="text-xs text-slate-300 flex items-center gap-3">
          <a href="/notificaciones" class="relative leading-none" aria-label="Notificaciones"><%- icono('bell') %><% if (notifCount > 0) { %><span class="absolute -top-1.5 -right-2 bg-red-500 text-white text-[9px] font-bold rounded-full min-w-[15px] h-[15px] px-1 flex items-center justify-center"><%= notifCount > 9 ? '9+' : notifCount %></span><% } %></a>
          <%= currentUser ? currentUser.nombre : '' %>
          <form method="POST" action="/logout"><button class="text-brand-300">Salir</button></form>
        </span>
      </header>

      <!-- Barra superior (desktop) -->
      <div class="hidden md:flex items-center justify-end gap-4 px-8 pt-5">
        <a href="/notificaciones" class="relative text-slate-500 hover:text-slate-800 leading-none" aria-label="Notificaciones">
          <%- icono('bell', 22) %><% if (notifCount > 0) { %><span class="absolute -top-1.5 -right-2 bg-red-500 text-white text-[10px] font-bold rounded-full min-w-[16px] h-[16px] px-1 flex items-center justify-center"><%= notifCount > 9 ? '9+' : notifCount %></span><% } %>
        </a>
      </div>

      <main class="flex-1 px-3 py-4 sm:px-8 sm:pt-4 sm:pb-8 <%= navFlat.length > 1 ? 'pb-24' : 'pb-8' %> md:pb-8 max-w-6xl w-full mx-auto">
        <div class="page-enter">
          <%- body %>
        </div>
      </main>
      <footer class="hidden md:block text-center text-xs text-slate-400 py-5">Flaks Gestión · uso interno</footer>
    </div>
  </div>

  <!-- Barra de navegación inferior (mobile) -->
  <% if (navFlat.length > 1) { %>
  <nav class="md:hidden fixed bottom-0 inset-x-0 z-30 bg-white border-t border-slate-200 grid pb-[env(safe-area-inset-bottom)]"
       style="grid-template-columns: repeat(<%= navFlat.length %>, minmax(0, 1fr));">
    <% navFlat.forEach(function(item){ const activo = _act(item[0]) || (item[0] === '/facturacion' && (currentPath.indexOf('/gastos') === 0 || currentPath.indexOf('/caja') === 0)); %>
      <a href="<%= item[0] %>" class="flex flex-col items-center justify-center gap-0.5 py-2 text-[10px] <%= activo ? 'text-brand-600' : 'text-slate-400' %>">
        <span class="leading-none"><%- icono(item[2], 20) %></span>
        <span class="leading-none"><%= item[1] %></span>
      </a>
    <% }); %>
  </nav>
  <% } %>

  <!-- Toast (flash) -->
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div id="toast" class="toast fixed top-16 sm:top-4 right-3 left-3 sm:left-auto z-50 sm:w-96">
      <div class="relative overflow-hidden rounded-xl shadow-card border <%= flash.tipo === 'error' ? 'bg-white border-red-200' : 'bg-white border-green-200' %>">
        <div class="flex items-start gap-3 p-4">
          <% if (flash.tipo === 'error') { %>
            <span class="shrink-0 mt-0.5 w-6 h-6 rounded-full bg-red-100 text-red-600 flex items-center justify-center font-bold">!</span>
          <% } else { %>
            <span class="toast-check shrink-0 mt-0.5 w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center">
              <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.79a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
            </span>
          <% } %>
          <div class="text-sm text-slate-700 flex-1"><%= flash.msg %></div>
          <button onclick="document.getElementById('toast').classList.add('hide')" class="shrink-0 text-slate-400 hover:text-slate-600 text-lg leading-none">&times;</button>
        </div>
        <div class="toast-bar h-0.5 <%= flash.tipo === 'error' ? 'bg-red-400' : 'bg-green-400' %>"></div>
      </div>
    </div>
    <script>
      (function () {
        var t = document.getElementById('toast');
        if (!t) return;
        var kill = function () { t.classList.add('hide'); setTimeout(function () { t.remove(); }, 300); };
        setTimeout(kill, 3600);
        t.addEventListener('click', function (e) { if (e.target.tagName !== 'A') kill(); });
      })();
    </script>
  <% } %>
</body>
</html>
