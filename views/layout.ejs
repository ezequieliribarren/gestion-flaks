<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %>Flaks Gestión</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📋</text></svg>" />
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="hidden md:flex md:flex-col w-56 bg-slate-900 text-slate-200 shrink-0">
      <div class="px-5 py-4 text-xl font-bold text-white border-b border-slate-700">Flaks</div>
      <nav class="flex-1 py-4 space-y-1">
        <% const nav = [
          ['/tareas', 'Tareas', '📝'],
          ['/clientes', 'Clientes', '👥'],
          ['/facturacion', 'Facturación', '💰'],
          ['/gastos', 'Gastos', '🧾'],
          ['/caja', 'Caja', '📊'],
          ['/documentos', 'Documentos', '📁'],
        ]; %>
        <% nav.forEach(function(item){ const activo = currentPath.indexOf(item[0]) === 0; %>
          <a href="<%= item[0] %>" class="flex items-center gap-3 px-5 py-2.5 text-sm <%= activo ? 'bg-slate-800 text-white border-l-4 border-blue-500' : 'hover:bg-slate-800 border-l-4 border-transparent' %>">
            <span><%= item[2] %></span><span><%= item[1] %></span>
          </a>
        <% }); %>
      </nav>
      <div class="px-5 py-4 border-t border-slate-700 text-xs">
        <div class="mb-2 text-slate-400">Sesión: <span class="text-white"><%= currentUser ? currentUser.nombre : '' %></span></div>
        <form method="POST" action="/logout"><button class="text-blue-400 hover:underline">Cerrar sesión</button></form>
      </div>
    </aside>

    <!-- Contenido -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Header móvil -->
      <header class="md:hidden bg-slate-900 text-white flex items-center justify-between px-4 py-3">
        <span class="font-bold">Flaks</span>
        <details class="relative">
          <summary class="list-none cursor-pointer">☰</summary>
          <div class="absolute right-0 mt-2 w-44 bg-white text-slate-800 rounded shadow-lg z-10 py-1">
            <a class="block px-4 py-2 text-sm hover:bg-slate-100" href="/tareas">Tareas</a>
            <a class="block px-4 py-2 text-sm hover:bg-slate-100" href="/clientes">Clientes</a>
            <a class="block px-4 py-2 text-sm hover:bg-slate-100" href="/facturacion">Facturación</a>
            <a class="block px-4 py-2 text-sm hover:bg-slate-100" href="/gastos">Gastos</a>
            <a class="block px-4 py-2 text-sm hover:bg-slate-100" href="/caja">Caja</a>
            <a class="block px-4 py-2 text-sm hover:bg-slate-100" href="/documentos">Documentos</a>
            <form method="POST" action="/logout"><button class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-slate-100">Cerrar sesión</button></form>
          </div>
        </details>
      </header>

      <main class="flex-1 p-4 sm:p-6 max-w-6xl w-full mx-auto">
        <% if (typeof flash !== 'undefined' && flash) { %>
          <div class="mb-4 rounded-md px-4 py-3 text-sm <%= flash.tipo === 'error' ? 'bg-red-100 text-red-800 border border-red-200' : 'bg-green-100 text-green-800 border border-green-200' %>">
            <%= flash.msg %>
          </div>
        <% } %>
        <%- body %>
      </main>
      <footer class="text-center text-xs text-slate-400 py-4">Flaks Gestión · uso interno</footer>
    </div>
  </div>
</body>
</html>
