<div class="mb-5">
  <h1 class="text-2xl font-bold text-slate-800 tracking-tight"><%= saludoTexto %> 👋</h1>
  <p class="text-sm text-slate-500 mt-0.5">Esto es lo que está pasando hoy.</p>
</div>

<div class="columns-1 sm:columns-2 xl:columns-3 gap-4" style="column-gap: 1rem;">

  <!-- Tareas vencidas -->
  <% if (!ocultas.has('tareas_vencidas')) { %>
  <div class="relative break-inside-avoid mb-4 bg-white rounded-xl shadow-card p-4 sm:p-5">
    <form method="POST" action="/inicio/tarjetas/tareas_vencidas/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">⏰ Tareas vencidas</div>
    <% if (!tareasVencidas.total) { %>
      <p class="text-sm text-green-600 mt-2">🎉 No hay tareas vencidas.</p>
    <% } else { %>
      <div class="flex items-end gap-2 mt-1 mb-2">
        <span class="text-4xl font-bold text-red-500"><%= tareasVencidas.total %></span>
        <span class="text-sm text-slate-400 mb-1">vencida<%= tareasVencidas.total === 1 ? '' : 's' %></span>
      </div>
      <ul class="text-sm text-slate-600 space-y-0.5 mb-2">
        <% tareasVencidas.titulos.forEach(function(t){ %><li class="truncate">· <%= t %></li><% }); %>
      </ul>
      <% if (tareasVencidas.total > tareasVencidas.titulos.length) { %>
        <p class="text-xs text-slate-400 mb-2">+<%= tareasVencidas.total - tareasVencidas.titulos.length %> más</p>
      <% } %>
    <% } %>
    <a href="/tareas" class="text-sm text-brand-600 hover:underline">Ver tareas →</a>
  </div>
  <% } %>

  <!-- Objetivos a la vista -->
  <% if (!ocultas.has('objetivos')) { %>
  <div class="relative break-inside-avoid mb-4 bg-white rounded-xl shadow-card p-4 sm:p-5">
    <form method="POST" action="/inicio/tarjetas/objetivos/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">🎯 Objetivos a la vista</div>
    <% if (!objetivos.total) { %>
      <p class="text-sm text-slate-400 mt-2 mb-2">Todavía no hay objetivos cargados.</p>
    <% } else { %>
      <ul class="text-sm text-slate-700 space-y-1.5 mt-2 mb-2">
        <% objetivos.mensuales.forEach(function(o){ %>
          <li class="flex items-start gap-2">
            <form method="POST" action="/marketing/objetivos/<%= o.id %>"><input type="hidden" name="_accion" value="toggle" />
              <button class="w-4 h-4 mt-0.5 rounded border border-slate-300 shrink-0"></button>
            </form>
            <span class="truncate"><%= o.texto %></span>
          </li>
        <% }); %>
        <% objetivos.largoPlazo.forEach(function(o){ %>
          <li class="flex items-start gap-2">
            <form method="POST" action="/marketing/objetivos/<%= o.id %>"><input type="hidden" name="_accion" value="toggle" />
              <button class="w-4 h-4 mt-0.5 rounded border border-indigo-300 shrink-0"></button>
            </form>
            <span class="truncate">🏔️ <%= o.texto %></span>
          </li>
        <% }); %>
      </ul>
    <% } %>
    <a href="/marketing#objetivos" class="text-sm text-brand-600 hover:underline">Ver Objetivos →</a>
  </div>
  <% } %>

  <!-- Contenido de la semana -->
  <% if (!ocultas.has('contenido_semana')) { %>
  <div class="relative break-inside-avoid mb-4 bg-white rounded-xl shadow-card p-4 sm:p-5">
    <form method="POST" action="/inicio/tarjetas/contenido_semana/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">📸 Publicaciones de la semana</div>
    <% if (!contenido.hayClientes) { %>
      <p class="text-sm text-slate-400 mt-2 mb-2">No hay clientes con Sheet de planificación cargado.</p>
    <% } else if (!contenido.totalFaltante) { %>
      <p class="text-sm text-green-600 mt-2 mb-2">🎉 Todos los clientes están al día con sus publicaciones de la semana.</p>
    <% } else { %>
      <div class="flex items-end gap-2 mt-1 mb-2">
        <span class="text-4xl font-bold text-amber-500"><%= contenido.totalFaltante %></span>
        <span class="text-sm text-slate-400 mb-1"><%= contenido.totalFaltante === 1 ? 'publicación pendiente' : 'publicaciones pendientes' %></span>
      </div>
      <ul class="text-sm text-slate-600 space-y-0.5 mb-2">
        <% contenido.conFaltante.forEach(function(c){ %>
          <li class="truncate">· <%= c.faltante %> de <%= c.cliente %></li>
        <% }); %>
      </ul>
    <% } %>
    <a href="/contenido" class="text-sm text-brand-600 hover:underline">Ver Contenido →</a>
  </div>
  <% } %>

  <!-- Saldo entre socios -->
  <% if (!ocultas.has('saldo_socios')) { %>
  <div class="relative break-inside-avoid mb-4 bg-white rounded-xl shadow-card p-4 sm:p-5">
    <form method="POST" action="/inicio/tarjetas/saldo_socios/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">🤝 Saldo entre socios</div>
    <% if (saldoSocios.igualado) { %>
      <p class="text-sm text-green-600 mt-2 mb-2">✅ Todo igualado entre German y Ezequiel.</p>
    <% } else { %>
      <p class="text-lg font-semibold text-slate-800 mt-2 mb-1"><%= saldoSocios.deQuien %> le debe a <%= saldoSocios.aQuien %></p>
      <p class="text-2xl font-bold text-amber-600 mb-2"><%= fmt.formatARS(saldoSocios.montoAIgualar) %></p>
    <% } %>
    <a href="/gastos" class="text-sm text-brand-600 hover:underline">Ver Gastos →</a>
  </div>
  <% } %>

  <!-- Pagos pendientes de este mes (recurrentes vencidos/por vencer + trabajos sin cobrar) -->
  <% if (!ocultas.has('pagos_pendientes')) { %>
    <div class="relative break-inside-avoid mb-4 bg-white rounded-xl shadow-card p-4 sm:p-5">
      <form method="POST" action="/inicio/tarjetas/pagos_pendientes/ocultar" class="absolute top-2 right-2">
        <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
      </form>
      <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">💳 Pagos pendientes de este mes</div>
      <% if (!pagosPendientes.total) { %>
        <p class="text-sm text-green-600 mt-2">🎉 No hay pagos pendientes este mes.</p>
      <% } else { %>
        <div class="flex items-end gap-2 mt-1 mb-2">
          <span class="text-4xl font-bold text-amber-500"><%= pagosPendientes.total %></span>
          <span class="text-sm text-slate-400 mb-1"><%= fmt.formatARS(pagosPendientes.monto) %></span>
        </div>
        <ul class="text-sm text-slate-600 space-y-1 mb-2">
          <% pagosPendientes.filas.forEach(function(f){ %>
            <li class="flex items-center justify-between gap-2">
              <a href="/clientes/<%= f.cliente_id %>#<%= f.tipo === 'recurrente' ? 'recurrentes' : 'unicos' %>" class="truncate hover:text-brand-600">
                <%= f.vencido ? '⚠ ' : '' %><%= f.cliente %> <span class="text-slate-400">· <%= f.concepto %></span>
              </a>
              <span class="text-slate-500 shrink-0"><%= fmt.formatARS(f.monto) %></span>
            </li>
          <% }); %>
        </ul>
        <% if (pagosPendientes.total > pagosPendientes.filas.length) { %>
          <p class="text-xs text-slate-400 mb-2">+<%= pagosPendientes.total - pagosPendientes.filas.length %> más</p>
        <% } %>
      <% } %>
      <a href="/facturacion" class="text-sm text-brand-600 hover:underline">Ver Facturación →</a>
    </div>
  <% } %>

  <!-- Deuda de meses anteriores (más chica) -->
  <% if (!ocultas.has('deuda_antigua') && deudaAntigua.total) { %>
    <div class="relative break-inside-avoid mb-4 bg-white rounded-xl shadow-card p-4">
      <form method="POST" action="/inicio/tarjetas/deuda_antigua/ocultar" class="absolute top-2 right-2">
        <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
      </form>
      <div class="text-xs text-red-500 uppercase tracking-wide mb-1">🕓 Deuda de meses anteriores</div>
      <div class="flex items-end gap-2 mt-1 mb-2">
        <span class="text-2xl font-bold text-red-600"><%= deudaAntigua.total %></span>
        <span class="text-sm text-slate-400 mb-0.5"><%= fmt.formatARS(deudaAntigua.monto) %></span>
      </div>
      <ul class="text-xs text-slate-600 space-y-1 mb-1">
        <% deudaAntigua.filas.forEach(function(f){ %>
          <li class="flex items-center justify-between gap-2">
            <a href="/clientes/<%= f.cliente_id %>#unicos" class="truncate hover:text-brand-600"><%= f.cliente %> <span class="text-slate-400">· <%= f.concepto %> (<%= fmt.formatFecha(f.fecha) %>)</span></a>
            <span class="text-slate-500 shrink-0"><%= fmt.formatARS(f.monto) %></span>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <!-- Facturado del mes -->
  <% if (!ocultas.has('facturado_mes')) { %>
  <div class="relative break-inside-avoid mb-4 bg-white rounded-xl shadow-card p-4 sm:p-5">
    <form method="POST" action="/inicio/tarjetas/facturado_mes/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">💰 Facturado del mes <span class="normal-case text-slate-400">(<%= nombreMes %>)</span></div>
    <div class="text-3xl font-bold text-slate-800 mt-1 mb-2"><%= fmt.formatARS(facturadoMes.total) %></div>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Cobrado del mes</div>
    <div class="flex gap-4 text-sm mb-2">
      <div><div class="text-[11px] text-slate-400">Cobrado</div><div class="font-semibold text-green-600"><%= fmt.formatARS(facturadoMes.cobrado) %></div></div>
      <div><div class="text-[11px] text-slate-400">Pendiente por cobrar</div><div class="font-semibold text-amber-600"><%= fmt.formatARS(facturadoMes.pendiente) %></div></div>
    </div>
    <a href="/facturacion" class="text-sm text-brand-600 hover:underline">Ver Facturación →</a>
  </div>
  <% } %>

  <!-- Mes anterior -->
  <% if (!ocultas.has('mes_anterior')) { %>
  <div class="relative break-inside-avoid mb-4 bg-white rounded-xl shadow-card p-4">
    <form method="POST" action="/inicio/tarjetas/mes_anterior/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">📅 Mes anterior <span class="normal-case text-slate-400">(<%= mesAnterior.nombre %>)</span></div>
    <div class="text-xl font-bold text-slate-800 mt-1">Facturado: <%= fmt.formatARS(mesAnterior.total) %></div>
  </div>
  <% } %>

  <!-- Mes posterior (proyección) -->
  <% if (!ocultas.has('mes_posterior')) { %>
  <div class="relative break-inside-avoid mb-4 bg-white rounded-xl shadow-card p-4">
    <form method="POST" action="/inicio/tarjetas/mes_posterior/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">🔮 Mes que viene <span class="normal-case text-slate-400">(<%= mesPosterior.nombre %>)</span></div>
    <div class="text-xl font-bold text-slate-800 mt-1">Proyectado: <%= fmt.formatARS(mesPosterior.total) %></div>
    <p class="text-[11px] text-slate-400 mt-1">Recurrentes activos + trabajos potenciales cargados.</p>
  </div>
  <% } %>

  <!-- Dólar MEP -->
  <% if (!ocultas.has('dolar_mep')) { %>
  <div class="relative break-inside-avoid mb-4 bg-white rounded-xl shadow-card p-4">
    <form method="POST" action="/inicio/tarjetas/dolar_mep/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">💵 Dólar MEP</div>
    <% if (dolar) { %>
      <div class="flex gap-4 mt-1">
        <div><div class="text-[11px] text-slate-400">Compra</div><div class="text-lg font-bold text-slate-800">$<%= dolar.compra.toLocaleString('es-AR') %></div></div>
        <div><div class="text-[11px] text-slate-400">Venta</div><div class="text-lg font-bold text-slate-800">$<%= dolar.venta.toLocaleString('es-AR') %></div></div>
      </div>
    <% } else { %>
      <p class="text-sm text-slate-400 mt-1">No disponible ahora.</p>
    <% } %>
  </div>
  <% } %>

  <!-- Clima -->
  <% if (!ocultas.has('clima')) { %>
  <div class="relative break-inside-avoid mb-4 bg-white rounded-xl shadow-card p-4">
    <form method="POST" action="/inicio/tarjetas/clima/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">🌤️ Clima Capital Federal</div>
    <% if (clima) { %>
      <div class="flex items-center gap-2 mt-1">
        <span class="text-3xl"><%= clima.icono %></span>
        <div><div class="text-xl font-bold text-slate-800"><%= clima.temp %>°C</div><div class="text-xs text-slate-400"><%= clima.descripcion %></div></div>
      </div>
    <% } else { %>
      <p class="text-sm text-slate-400 mt-1">No disponible ahora.</p>
    <% } %>
  </div>
  <% } %>

</div>

<% var ocultasArr = TARJETAS.filter(function(t){ return ocultas.has(t.id); }); %>
<% if (ocultasArr.length) { %>
  <details class="bg-white rounded-xl shadow-card p-4 mt-2">
    <summary class="text-sm text-brand-600 cursor-pointer">Tarjetas ocultas (<%= ocultasArr.length %>)</summary>
    <ul class="mt-3 divide-y divide-slate-100">
      <% ocultasArr.forEach(function(t){ %>
        <li class="flex items-center justify-between gap-3 py-2">
          <span class="text-sm text-slate-600"><%= t.label %></span>
          <form method="POST" action="/inicio/tarjetas/<%= t.id %>/mostrar">
            <button class="text-xs text-brand-600 hover:underline">Volver a mostrar</button>
          </form>
        </li>
      <% }); %>
    </ul>
  </details>
<% } %>
