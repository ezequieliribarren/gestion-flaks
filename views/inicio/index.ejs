<div class="flex items-start justify-between gap-3 flex-wrap mb-3">
  <div>
    <h1 class="text-xl lg:text-2xl font-bold text-slate-800 tracking-tight"><%= saludoTexto %> 👋</h1>
    <p class="text-sm text-slate-500 mt-0.5">Esto es lo que está pasando hoy.</p>
  </div>

  <!-- Clima + Dólar: chiquito, arriba -->
  <div class="flex items-center gap-2 text-xs">
    <% if (!ocultas.has('clima') && clima) { %>
      <div class="group flex items-center gap-1.5 bg-white rounded-full pl-3 pr-1.5 py-1.5 shadow-card">
        <span class="text-base leading-none"><%= clima.icono %></span>
        <span class="font-semibold text-slate-700"><%= clima.temp %>°</span>
        <form method="POST" action="/inicio/tarjetas/clima/ocultar" class="opacity-0 group-hover:opacity-100">
          <button class="w-4 h-4 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 leading-none" title="Ocultar">✕</button>
        </form>
      </div>
    <% } %>
    <% if (!ocultas.has('dolar_mep') && dolar) { %>
      <div class="group flex items-center gap-1.5 bg-white rounded-full pl-3 pr-1.5 py-1.5 shadow-card">
        <span class="text-slate-400">MEP</span>
        <span class="font-semibold text-slate-700">$<%= dolar.venta.toLocaleString('es-AR') %></span>
        <form method="POST" action="/inicio/tarjetas/dolar_mep/ocultar" class="opacity-0 group-hover:opacity-100">
          <button class="w-4 h-4 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 leading-none" title="Ocultar">✕</button>
        </form>
      </div>
    <% } %>
  </div>
</div>

<%
  // Paleta reducida a propósito: rojo sólo para lo urgente, verde de marca para plata,
  // gris neutro para el resto (menos "arcoíris", más profesional).
  function card(color) {
    return { red: 'border-red-300', brand: 'border-brand-300', amber: 'border-amber-300' }[color] || 'border-slate-200';
  }
%>

<!-- Hoy -->
<h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2">Hoy</h2>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3 items-start mb-4">

  <!-- Tareas vencidas -->
  <% if (!ocultas.has('tareas_vencidas')) { %>
  <div class="relative bg-white rounded-xl shadow-card p-3.5 border-l-4 <%= card('red') %>">
    <form method="POST" action="/inicio/tarjetas/tareas_vencidas/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Tareas vencidas</div>
    <% if (!tareasVencidas.total) { %>
      <p class="text-sm text-green-600 mt-2">🎉 No hay tareas vencidas.</p>
    <% } else { %>
      <div class="flex items-end gap-2 mt-1 mb-1.5">
        <span class="text-3xl font-bold text-red-500"><%= tareasVencidas.total %></span>
        <span class="text-sm text-slate-400 mb-0.5">vencida<%= tareasVencidas.total === 1 ? '' : 's' %></span>
      </div>
      <ul class="text-sm text-slate-600 space-y-0.5 mb-1.5">
        <% tareasVencidas.titulos.forEach(function(t){ %><li class="truncate">· <%= t %></li><% }); %>
      </ul>
      <% if (tareasVencidas.total > tareasVencidas.titulos.length) { %>
        <p class="text-xs text-slate-400 mb-1.5">+<%= tareasVencidas.total - tareasVencidas.titulos.length %> más</p>
      <% } %>
    <% } %>
    <a href="/tareas" class="text-sm text-brand-600 hover:underline">Ver tareas →</a>
  </div>
  <% } %>

  <!-- Pagos pendientes de este mes -->
  <% if (!ocultas.has('pagos_pendientes')) { %>
    <div class="relative bg-white rounded-xl shadow-card p-3.5 border-l-4 <%= card() %>">
      <form method="POST" action="/inicio/tarjetas/pagos_pendientes/ocultar" class="absolute top-2 right-2">
        <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
      </form>
      <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Pagos pendientes de este mes</div>
      <% if (!pagosPendientes.total) { %>
        <p class="text-sm text-green-600 mt-2">🎉 No hay pagos pendientes este mes.</p>
      <% } else { %>
        <div class="flex items-end gap-2 mt-1 mb-1.5">
          <span class="text-3xl font-bold text-slate-700"><%= pagosPendientes.total %></span>
          <span class="text-sm text-slate-400 mb-0.5"><%= fmt.formatARS(pagosPendientes.monto) %></span>
        </div>
        <ul class="text-sm text-slate-600 space-y-1 mb-1.5">
          <% pagosPendientes.filas.forEach(function(f){ %>
            <li class="flex items-center justify-between gap-2">
              <a href="/clientes/<%= f.cliente_id %>#<%= f.tipo === 'recurrente' ? 'recurrentes' : 'unicos' %>" class="truncate hover:text-brand-600">
                <%= f.vencido ? '⚠ ' : '' %><%= f.cliente %> <span class="text-slate-400">· <%= f.concepto %></span>
              </a>
              <span class="text-slate-500 shrink-0"><%= fmt.formatARS(f.monto) %></span>
            </li>
          <% }); %>
        </ul>
        <% if (pagosPendientes.total > pagosPendientes.filas.length) { %>
          <p class="text-xs text-slate-400 mb-1.5">+<%= pagosPendientes.total - pagosPendientes.filas.length %> más</p>
        <% } %>
      <% } %>
      <a href="/facturacion" class="text-sm text-brand-600 hover:underline">Ver Facturación →</a>
    </div>
  <% } %>

  <!-- Deuda de meses anteriores -->
  <% if (!ocultas.has('deuda_antigua') && deudaAntigua.total) { %>
    <div class="relative bg-white rounded-xl shadow-card p-3.5 border-l-4 <%= card('red') %>">
      <form method="POST" action="/inicio/tarjetas/deuda_antigua/ocultar" class="absolute top-2 right-2">
        <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
      </form>
      <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Deuda de meses anteriores</div>
      <div class="flex items-end gap-2 mt-1 mb-1.5">
        <span class="text-2xl font-bold text-red-600"><%= deudaAntigua.total %></span>
        <span class="text-sm text-slate-400 mb-0.5"><%= fmt.formatARS(deudaAntigua.monto) %></span>
      </div>
      <ul class="text-xs text-slate-600 space-y-1 mb-1">
        <% deudaAntigua.filas.forEach(function(f){ %>
          <li class="flex items-center justify-between gap-2">
            <a href="/clientes/<%= f.cliente_id %>#unicos" class="truncate hover:text-brand-600"><%= f.cliente %> <span class="text-slate-400">· <%= f.concepto %> (<%= fmt.formatFecha(f.fecha) %>)</span></a>
            <span class="text-slate-500 shrink-0"><%= fmt.formatARS(f.monto) %></span>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <!-- Contenido de la semana -->
  <% if (!ocultas.has('contenido_semana')) { %>
  <div class="relative bg-white rounded-xl shadow-card p-3.5 border-l-4 <%= card() %>">
    <form method="POST" action="/inicio/tarjetas/contenido_semana/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Publicaciones de la semana</div>
    <% if (!contenido.hayClientes) { %>
      <p class="text-sm text-slate-400 mt-2 mb-1.5">No hay clientes con Sheet de planificación cargado.</p>
    <% } else if (!contenido.totalFaltante) { %>
      <p class="text-sm text-green-600 mt-2 mb-1.5">🎉 Todos los clientes están al día con sus publicaciones de la semana.</p>
    <% } else { %>
      <div class="flex items-end gap-2 mt-1 mb-1.5">
        <span class="text-3xl font-bold text-slate-700"><%= contenido.totalFaltante %></span>
        <span class="text-sm text-slate-400 mb-0.5"><%= contenido.totalFaltante === 1 ? 'publicación pendiente' : 'publicaciones pendientes' %></span>
      </div>
      <ul class="text-sm text-slate-600 space-y-0.5 mb-1.5">
        <% contenido.conFaltante.slice(0,3).forEach(function(c){ %>
          <li class="truncate">· <%= c.faltante %> de <%= c.cliente %></li>
        <% }); %>
      </ul>
    <% } %>
    <a href="/contenido" class="text-sm text-brand-600 hover:underline">Ver Contenido →</a>
  </div>
  <% } %>

  <!-- Objetivos a la vista -->
  <% if (!ocultas.has('objetivos')) { %>
  <div class="relative bg-white rounded-xl shadow-card p-3.5 border-l-4 <%= card() %>">
    <form method="POST" action="/inicio/tarjetas/objetivos/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">🎯 Objetivos a la vista</div>
    <% if (!objetivos.total) { %>
      <p class="text-sm text-slate-400 mt-2 mb-1.5">Todavía no hay objetivos cargados.</p>
    <% } else { %>
      <ul class="text-sm text-slate-700 space-y-1.5 mt-2 mb-1.5">
        <% objetivos.mensuales.slice(0,3).forEach(function(o){ %>
          <li class="flex items-start gap-2">
            <form method="POST" action="/tareas/objetivos/<%= o.id %>"><input type="hidden" name="_accion" value="toggle" />
              <button class="w-4 h-4 mt-0.5 rounded border border-slate-300 shrink-0"></button>
            </form>
            <span class="truncate"><%= o.texto %></span>
          </li>
        <% }); %>
        <% objetivos.largoPlazo.slice(0,2).forEach(function(o){ %>
          <li class="flex items-start gap-2">
            <form method="POST" action="/tareas/objetivos/<%= o.id %>"><input type="hidden" name="_accion" value="toggle" />
              <button class="w-4 h-4 mt-0.5 rounded border border-slate-300 shrink-0"></button>
            </form>
            <span class="truncate">🏔️ <%= o.texto %></span>
          </li>
        <% }); %>
      </ul>
    <% } %>
    <a href="/tareas/flaks#objetivos" class="text-sm text-brand-600 hover:underline">Ver Objetivos →</a>
  </div>
  <% } %>

  <!-- Saldo entre socios -->
  <% if (!ocultas.has('saldo_socios')) { %>
  <div class="relative bg-white rounded-xl shadow-card p-3.5 border-l-4 <%= card() %>">
    <form method="POST" action="/inicio/tarjetas/saldo_socios/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Saldo entre socios</div>
    <% if (saldoSocios.igualado) { %>
      <p class="text-sm text-green-600 mt-2 mb-1.5">✅ Todo igualado entre German y Ezequiel.</p>
    <% } else { %>
      <p class="text-base font-semibold text-slate-800 mt-2 mb-0.5"><%= saldoSocios.deQuien %> le debe a <%= saldoSocios.aQuien %></p>
      <p class="text-xl font-bold text-slate-700 mb-1.5"><%= fmt.formatARS(saldoSocios.montoAIgualar) %></p>
    <% } %>
    <a href="/gastos" class="text-sm text-brand-600 hover:underline">Ver Gastos →</a>
  </div>
  <% } %>

</div>

<!-- Facturación -->
<h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2">Facturación</h2>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3 items-start">

  <!-- Facturado del mes: una sola tarjeta, deslizable entre mes anterior / actual / siguiente -->
  <% if (!ocultas.has('facturado_mes')) { %>
  <div class="relative bg-white rounded-xl shadow-card p-3.5 border-l-4 <%= card('brand') %> overflow-hidden" id="card-mes-fact">
    <form method="POST" action="/inicio/tarjetas/facturado_mes/ocultar" class="absolute top-2 right-2 z-10">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>

    <div class="flex items-stretch gap-1">
      <button type="button" class="mes-nav shrink-0 w-6 rounded-lg text-slate-300 hover:bg-slate-100 hover:text-slate-600 flex items-center justify-center" data-dir="-1" aria-label="Ver mes anterior">‹</button>

      <div class="flex-1 overflow-hidden">
        <div class="mes-track flex transition-transform duration-200 ease-out" style="width: 300%; transform: translateX(-33.3333%);">
          <div class="mes-slide w-1/3 px-1 text-center">
            <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Mes anterior <span class="normal-case text-slate-400">(<%= mesAnterior.nombre %>)</span></div>
            <div class="text-lg font-bold text-slate-800 mt-1">Facturado: <%= fmt.formatARS(mesAnterior.total) %></div>
            <div class="text-[11px] text-slate-400 mt-1">Recurrentes <%= fmt.formatARS(mesAnterior.recurrentes) %> · Únicos <%= fmt.formatARS(mesAnterior.unicos) %></div>
          </div>
          <div class="mes-slide w-1/3 px-1 text-center">
            <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Facturado del mes <span class="normal-case text-slate-400">(<%= nombreMes %>)</span></div>
            <div class="text-2xl font-bold text-slate-800 mt-1 mb-1.5"><%= fmt.formatARS(facturadoMes.total) %></div>
            <div class="flex gap-4 text-sm mb-1.5 justify-center">
              <div><div class="text-[11px] text-slate-400">Cobrado</div><div class="font-semibold text-green-600"><%= fmt.formatARS(facturadoMes.cobrado) %></div></div>
              <div><div class="text-[11px] text-slate-400">Pendiente</div><div class="font-semibold text-slate-600"><%= fmt.formatARS(facturadoMes.pendiente) %></div></div>
            </div>
            <div class="text-[11px] text-slate-400 mb-1">Recurrentes <%= fmt.formatARS(facturadoMes.recurrentes) %> · Únicos <%= fmt.formatARS(facturadoMes.unicos) %></div>
            <% if (facturadoMes.sistemaContinuo != null) {
              var scDelta = facturadoMes.sistemaContinuo - (facturadoMes.sistemaContinuoAnterior || 0);
              var scSube = scDelta >= 0;
            %>
              <div class="text-[11px] text-slate-500 mb-1.5">
                Sistema Continuo: <span class="font-medium text-slate-700"><%= fmt.formatARS(facturadoMes.sistemaContinuo) %></span>
                <% if (facturadoMes.sistemaContinuoAnterior != null) { %>
                  <span class="<%= scSube ? 'text-green-600' : 'text-red-600' %>"><%= scSube ? '▲' : '▼' %> <%= fmt.formatARS(Math.abs(scDelta)) %></span> vs mes ant.
                <% } %>
              </div>
            <% } %>
            <a href="/facturacion" class="text-sm text-brand-600 hover:underline">Ver Facturación →</a>
          </div>
          <div class="mes-slide w-1/3 px-1 text-center">
            <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Mes que viene <span class="normal-case text-slate-400">(<%= mesPosterior.nombre %>)</span></div>
            <div class="text-lg font-bold text-slate-800 mt-1">Proyectado: <%= fmt.formatARS(mesPosterior.total) %></div>
            <div class="text-[11px] text-slate-400 mt-1">Recurrentes <%= fmt.formatARS(mesPosterior.recurrentes) %> · Únicos <%= fmt.formatARS(mesPosterior.unicos) %></div>
          </div>
        </div>
      </div>

      <button type="button" class="mes-nav shrink-0 w-6 rounded-lg text-slate-300 hover:bg-slate-100 hover:text-slate-600 flex items-center justify-center" data-dir="1" aria-label="Ver mes que viene">›</button>
    </div>

    <div class="flex justify-center gap-1.5 mt-2">
      <span class="mes-dot w-1.5 h-1.5 rounded-full bg-slate-300" data-i="0"></span>
      <span class="mes-dot w-1.5 h-1.5 rounded-full bg-brand-600" data-i="1"></span>
      <span class="mes-dot w-1.5 h-1.5 rounded-full bg-slate-300" data-i="2"></span>
    </div>
  </div>
  <script>
    (function () {
      var card = document.getElementById('card-mes-fact');
      if (!card) return;
      var track = card.querySelector('.mes-track');
      var dots = Array.prototype.slice.call(card.querySelectorAll('.mes-dot'));
      var idx = 1;
      function render() {
        track.style.transform = 'translateX(-' + (idx * 33.3333) + '%)';
        dots.forEach(function (d, i) {
          d.classList.toggle('bg-brand-600', i === idx);
          d.classList.toggle('bg-slate-300', i !== idx);
        });
      }
      card.querySelectorAll('.mes-nav').forEach(function (btn) {
        btn.addEventListener('click', function () {
          idx = Math.max(0, Math.min(2, idx + Number(btn.dataset.dir)));
          render();
        });
      });
      dots.forEach(function (d) {
        d.addEventListener('click', function () { idx = Number(d.dataset.i); render(); });
      });
    })();
  </script>
  <% } %>

  <!-- Gasto en publicidad (Meta/Google Ads, pauta) -->
  <% if (!ocultas.has('gasto_publicidad')) { %>
  <div class="relative bg-white rounded-xl shadow-card p-3.5 border-l-4 <%= card('amber') %>">
    <form method="POST" action="/inicio/tarjetas/gasto_publicidad/ocultar" class="absolute top-2 right-2">
      <button class="w-6 h-6 rounded-full text-slate-300 hover:bg-slate-100 hover:text-slate-500 text-sm" title="Ocultar tarjeta">✕</button>
    </form>
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Gasto en publicidad <span class="normal-case text-slate-400">(<%= nombreMes %>)</span></div>
    <div class="text-2xl font-bold text-slate-800 mt-1 mb-1"><%= fmt.formatARS(gastoPublicidad.total) %></div>
    <div class="text-[11px] text-slate-400 mb-1.5">
      <%= gastoPublicidad.cantidad %> gasto<%= gastoPublicidad.cantidad === 1 ? '' : 's' %> este mes
      <% if (gastoPublicidad.anterior != null) {
        var gpDelta = gastoPublicidad.total - gastoPublicidad.anterior;
        var gpSube = gpDelta >= 0;
      %>
        · <span class="<%= gpSube ? 'text-red-600' : 'text-green-600' %>"><%= gpSube ? '▲' : '▼' %> <%= fmt.formatARS(Math.abs(gpDelta)) %></span> vs mes ant.
      <% } %>
    </div>
    <div class="border-t border-slate-100 pt-1.5 mt-1.5 text-[11px] text-slate-500">
      <%= gastoPublicidad.clientesNuevos %> cliente<%= gastoPublicidad.clientesNuevos === 1 ? '' : 's' %> nuevo<%= gastoPublicidad.clientesNuevos === 1 ? '' : 's' %>
      · <%= gastoPublicidad.presupuestosConfirmados %> presupuesto<%= gastoPublicidad.presupuestosConfirmados === 1 ? '' : 's' %> confirmado<%= gastoPublicidad.presupuestosConfirmados === 1 ? '' : 's' %>
      <div class="mt-0.5">
        Retorno: <span class="font-medium text-slate-700"><%= fmt.formatARS(gastoPublicidad.retorno) %></span>
        <% if (gastoPublicidad.total > 0) { %>
          · ROAS: <span class="font-medium <%= gastoPublicidad.retorno >= gastoPublicidad.total ? 'text-green-600' : 'text-amber-600' %>"><%= (gastoPublicidad.retorno / gastoPublicidad.total).toFixed(2) %>x</span>
        <% } %>
      </div>
    </div>
    <a href="/gastos" class="text-sm text-brand-600 hover:underline">Ver Gastos →</a>
  </div>
  <% } %>

</div>

<% var ocultasArr = TARJETAS.filter(function(t){ return ocultas.has(t.id); }); %>
<% if (ocultasArr.length) { %>
  <details class="bg-white rounded-xl shadow-card p-4 mt-6">
    <summary class="text-sm text-brand-600 cursor-pointer">Tarjetas ocultas (<%= ocultasArr.length %>)</summary>
    <ul class="mt-3 divide-y divide-slate-100">
      <% ocultasArr.forEach(function(t){ %>
        <li class="flex items-center justify-between gap-3 py-2">
          <span class="text-sm text-slate-600"><%= t.label %></span>
          <form method="POST" action="/inicio/tarjetas/<%= t.id %>/mostrar">
            <button class="text-xs text-brand-600 hover:underline">Volver a mostrar</button>
          </form>
        </li>
      <% }); %>
    </ul>
  </details>
<% } %>
