<form method="GET" class="bg-white rounded-xl shadow-card p-4 mb-4 flex flex-wrap gap-3 items-end text-sm">
  <div>
    <label class="block text-xs text-slate-500 mb-1">Mes</label>
    <select name="mes" class="rounded-md border border-slate-300 px-2 py-1.5">
      <% for (var m = 1; m <= 12; m++) { %>
        <option value="<%= m %>" <%= mes === m ? 'selected' : '' %>><%= fmt.nombreMes(m) %></option>
      <% } %>
    </select>
  </div>
  <div>
    <label class="block text-xs text-slate-500 mb-1">Año</label>
    <input type="number" name="anio" value="<%= anio %>" min="2000" max="2100" class="w-24 rounded-md border border-slate-300 px-2 py-1.5" />
  </div>
  <% if (typeof mostrarPotenciales !== 'undefined' && mostrarPotenciales) { %>
    <label class="flex items-center gap-2">
      <input type="checkbox" name="potenciales" value="1" <%= incluirPotenciales ? 'checked' : '' %> />
      <span class="text-slate-600">Incluir clientes potenciales (proyección)</span>
    </label>
  <% } %>
  <button class="btn bg-slate-800 hover:bg-slate-900 text-white rounded-md px-3 py-1.5">Ver</button>
</form>
