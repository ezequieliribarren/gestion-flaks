<% if (historial && historial.length) { %>
  <details class="mt-3">
    <summary class="cursor-pointer text-xs text-brand-600 hover:underline">Ver historial completo (<%= historial.length %>)</summary>
    <ul class="mt-2 space-y-1 text-xs text-slate-500 border-l-2 border-slate-200 pl-3">
      <% historial.forEach(function(h){ %>
        <li>
          <span class="text-slate-400"><%= fmt.formatFechaHora(h.fecha) %></span> ·
          <span class="font-medium text-slate-600"><%= h.usuario %></span> ·
          <%= h.accion %><% if (h.detalle) { %> — <%= h.detalle %><% } %>
        </li>
      <% }); %>
    </ul>
  </details>
<% } %>
