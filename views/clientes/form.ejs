<div class="max-w-md mx-auto">
  <a href="/clientes" class="text-sm text-blue-600 hover:underline">&larr; Volver a clientes</a>
  <h1 class="text-2xl font-bold text-slate-800 mt-2 mb-4">Nuevo cliente</h1>

  <form method="POST" action="/clientes" class="bg-white rounded-lg shadow-sm p-6 space-y-4">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Nombre *</label>
      <input name="nombre" required class="w-full rounded-md border border-slate-300 px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Color identificatorio</label>
      <input type="color" name="color" value="#2563eb" class="h-10 w-20 rounded border border-slate-300" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Estado inicial</label>
      <select name="estado" class="w-full rounded-md border border-slate-300 px-3 py-2">
        <option value="potencial">Potencial (todavía no se le cobró)</option>
        <option value="activo">Activo</option>
      </select>
    </div>
    <div class="flex gap-2">
      <button class="bg-blue-600 hover:bg-blue-700 text-white rounded-md px-4 py-2 text-sm">Crear cliente</button>
      <a href="/clientes" class="text-slate-500 hover:underline text-sm self-center">Cancelar</a>
    </div>
  </form>
</div>
