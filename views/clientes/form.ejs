<div class="max-w-md mx-auto">
  <a href="/clientes" class="text-sm text-brand-600 hover:underline">&larr; Volver a clientes</a>
  <h1 class="text-2xl font-bold text-slate-800 mt-2 mb-4">Nuevo cliente</h1>

  <form method="POST" action="/clientes" enctype="multipart/form-data" class="bg-white rounded-xl shadow-card p-6 space-y-4">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Nombre *</label>
      <input name="nombre" required class="w-full rounded-md border border-slate-300 px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Logo (opcional)</label>
      <input type="file" name="logo" accept="image/*" class="w-full text-sm" />
      <p class="text-xs text-slate-400 mt-1">PNG, JPG, WEBP o SVG. Hasta 3 MB. Podés cambiarlo después.</p>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Estado inicial</label>
      <select name="estado" class="w-full rounded-md border border-slate-300 px-3 py-2">
        <option value="potencial">Potencial (todavía no se le cobró)</option>
        <option value="activo">Activo</option>
        <option value="inactivo">Inactivo (ya no trabajamos con él)</option>
      </select>
    </div>
    <div class="flex gap-2">
      <button class="btn bg-brand-600 hover:bg-brand-700 text-white rounded-md px-4 py-2 text-sm">Crear cliente</button>
      <a href="/clientes" class="text-slate-500 hover:underline text-sm self-center">Cancelar</a>
    </div>
  </form>
</div>
