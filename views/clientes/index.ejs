<%
  function badgeEstado(e){
    return {
      activo: 'bg-green-100 text-green-700',
      potencial: 'bg-amber-100 text-amber-700',
      inactivo: 'bg-slate-200 text-slate-500',
    }[e] || 'bg-slate-100 text-slate-600';
  }
  function etiquetaEstado(e){ return { activo:'Activo', potencial:'Potencial', inactivo:'Inactivo' }[e] || e; }
  function qs(extra){
    const base = {};
    if (vista) base.vista = vista;
    base.estado = filtroEstado || 'todos';
    if (orden) base.orden = orden;
    return new URLSearchParams(Object.assign(base, extra)).toString();
  }
  const n = { activo: conteo.activo || 0, potencial: conteo.potencial || 0, inactivo: conteo.inactivo || 0, total: conteo.total || 0 };
%>

<div class="flex items-center justify-between mb-5">
  <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Clientes</h1>
  <a href="/clientes/nuevo" class="btn bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg px-4 py-2 shadow-card">+ Agregar cliente</a>
</div>

<div class="flex flex-wrap items-center gap-2 mb-5">
  <!-- Filtro por estado -->
  <div class="flex gap-1 bg-white rounded-lg p-1 shadow-card">
    <a href="/clientes?<%= qs({ estado: 'activo' }) %>" class="btn px-3 py-1.5 text-sm rounded-md <%= filtroEstado === 'activo' ? 'bg-green-600 text-white' : 'text-slate-600 hover:bg-slate-100' %>">Activos <span class="opacity-60"><%= n.activo %></span></a>
    <a href="/clientes?<%= qs({ estado: 'potencial' }) %>" class="btn px-3 py-1.5 text-sm rounded-md <%= filtroEstado === 'potencial' ? 'bg-amber-500 text-white' : 'text-slate-600 hover:bg-slate-100' %>">Potenciales <span class="opacity-60"><%= n.potencial %></span></a>
    <a href="/clientes?<%= qs({ estado: 'inactivo' }) %>" class="btn px-3 py-1.5 text-sm rounded-md <%= filtroEstado === 'inactivo' ? 'bg-slate-500 text-white' : 'text-slate-600 hover:bg-slate-100' %>">Inactivos <span class="opacity-60"><%= n.inactivo %></span></a>
    <a href="/clientes?<%= qs({ estado: 'todos' }) %>" class="btn px-3 py-1.5 text-sm rounded-md <%= !filtroEstado ? 'bg-slate-800 text-white' : 'text-slate-600 hover:bg-slate-100' %>">Todos <span class="opacity-60"><%= n.total %></span></a>
  </div>

  <span class="text-slate-300">·</span>

  <!-- Orden -->
  <div class="flex gap-1 bg-white rounded-lg p-1 shadow-card">
    <a href="/clientes?<%= qs({ orden: 'nombre' }) %>" class="btn px-3 py-1.5 text-sm rounded-md <%= orden === 'nombre' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-100' %>">A → Z</a>
    <a href="/clientes?<%= qs({ orden: 'facturacion' }) %>" class="btn px-3 py-1.5 text-sm rounded-md <%= orden === 'facturacion' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-100' %>">Mayor facturación</a>
  </div>

  <span class="text-slate-300">·</span>

  <!-- Vista -->
  <div class="flex gap-1 bg-white rounded-lg p-1 shadow-card">
    <a href="/clientes?<%= qs({ vista: 'carpetas' }) %>" class="btn px-3 py-1.5 text-sm rounded-md <%= vista === 'carpetas' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-100' %>">Carpetas</a>
    <a href="/clientes?<%= qs({ vista: 'lista' }) %>" class="btn px-3 py-1.5 text-sm rounded-md <%= vista === 'lista' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-100' %>">Lista</a>
  </div>
</div>

<% if (!clientes.length) { %>
  <div class="bg-white rounded-xl shadow-card p-10 text-center text-slate-500">
    <%= filtroEstado ? 'No hay clientes en este estado.' : 'Todavía no hay clientes cargados.' %>
  </div>
<% } %>

<% if (vista === 'carpetas') { %>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
    <% clientes.forEach(function(c){ var ee = c.estado_efectivo; var reactivado = ee !== c.estado; %>
      <a href="/clientes/<%= c.id %>" class="lift block bg-white rounded-xl shadow-card hover:shadow-card-hover overflow-hidden <%= c.estado === 'inactivo' && !reactivado ? 'opacity-70' : '' %>">
        <div class="h-1.5" style="background: <%= c.color %>"></div>
        <div class="p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-3 h-3 rounded-full inline-block shrink-0" style="background: <%= c.color %>"></span>
            <span class="font-semibold text-slate-800 truncate"><%= c.nombre %></span>
          </div>
          <span class="text-[11px] font-medium px-2 py-0.5 rounded-full <%= badgeEstado(ee) %>"><%= etiquetaEstado(ee) %></span>
          <% if (reactivado) { %><span class="text-[11px] text-amber-600">· presupuesto pendiente</span><% } %>
          <div class="text-xs text-slate-500 mt-3 space-y-0.5">
            <div><%= fmt.formatARS(c.mensual) %> <span class="text-slate-400">/ mes</span></div>
            <div><%= c.tareas_abiertas %> tarea<%= c.tareas_abiertas === 1 ? '' : 's' %> abierta<%= c.tareas_abiertas === 1 ? '' : 's' %></div>
          </div>
        </div>
      </a>
    <% }); %>
  </div>
<% } else { %>
  <div class="bg-white rounded-xl shadow-card overflow-x-auto">
    <table class="zebra w-full text-sm">
      <thead class="bg-slate-50 text-slate-500 text-left border-b border-slate-100">
        <tr>
          <th class="px-4 py-3 font-medium">Cliente</th>
          <th class="px-4 py-3 font-medium">Estado</th>
          <th class="px-4 py-3 font-medium text-right">Mensual</th>
          <th class="px-4 py-3 font-medium text-right">Facturado total</th>
          <th class="px-4 py-3 font-medium text-right">Tareas abiertas</th>
        </tr>
      </thead>
      <tbody>
        <% clientes.forEach(function(c){ var ee = c.estado_efectivo; var reactivado = ee !== c.estado; %>
          <tr class="<%= c.estado === 'inactivo' && !reactivado ? 'text-slate-400' : '' %>">
            <td class="px-4 py-3">
              <a href="/clientes/<%= c.id %>" class="flex items-center gap-2 font-medium text-slate-800 hover:text-brand-600">
                <span class="w-2.5 h-2.5 rounded-full inline-block shrink-0" style="background: <%= c.color %>"></span><%= c.nombre %>
              </a>
            </td>
            <td class="px-4 py-3">
              <span class="text-[11px] font-medium px-2 py-0.5 rounded-full <%= badgeEstado(ee) %>"><%= etiquetaEstado(ee) %></span>
              <% if (reactivado) { %><span class="text-[11px] text-amber-600 block">presupuesto pendiente</span><% } %>
            </td>
            <td class="px-4 py-3 text-right tabular-nums"><%= fmt.formatARS(c.mensual) %></td>
            <td class="px-4 py-3 text-right tabular-nums font-medium"><%= fmt.formatARS(c.total_facturado) %></td>
            <td class="px-4 py-3 text-right tabular-nums"><%= c.tareas_abiertas %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
