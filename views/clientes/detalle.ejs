<%
  function etiquetaEstadoT(e){ return { pendiente:'Pendiente', en_progreso:'En progreso', completada:'Completada' }[e] || e; }
  // Select "Pasar a otro cliente" (auto-submit)
  function pasarSelect(recurso, tid){
    var opts = clientesLista
      .filter(function(c){ return c.id !== cliente.id; })
      .map(function(c){ return '<option value="' + c.id + '">' + c.nombre + '</option>'; })
      .join('');
    return '<form method="POST" action="/clientes/' + cliente.id + '/' + recurso + '/' + tid + '/pasar" class="mt-3">'
      + '<label class="block text-xs text-slate-500 mb-1">Pasar a otro cliente</label>'
      + '<select name="cliente_destino" onchange="if(this.value)this.form.submit()" '
      + 'class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm text-slate-500">'
      + '<option value="">Elegir…</option>' + opts + '</select></form>';
  }
  function estadoCliente(e){
    return {
      activo:    ['Activo', 'bg-green-100 text-green-700'],
      potencial: ['Potencial', 'bg-amber-100 text-amber-700'],
      inactivo:  ['Inactivo', 'bg-slate-200 text-slate-500'],
    }[e] || ['—', 'bg-slate-100 text-slate-600'];
  }
  function estadoTrabajoClase(e){
    return {
      pendiente: 'bg-red-100 text-red-700',
      potencial: 'bg-amber-100 text-amber-700',
    }[e] || 'bg-slate-100 text-slate-600';
  }
  // Íconos minimalistas de trazo (en vez de emoji) para esta ficha.
  function ic(name, size){
    var attrs = 'width="' + (size||15) + '" height="' + (size||15) + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"';
    var paths = {
      user: '<circle cx="12" cy="8" r="3.2"/><path d="M5.5 20c0-3.6 2.9-6.5 6.5-6.5s6.5 2.9 6.5 6.5"/>',
      phone: '<path d="M5 4.5h3l1.3 4-1.9 1.4a10.5 10.5 0 0 0 5.7 5.7l1.4-1.9 4 1.3v3a1.5 1.5 0 0 1-1.6 1.5A15 15 0 0 1 3.5 6.1 1.5 1.5 0 0 1 5 4.5Z"/>',
      mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="1.7"/><path d="m4.5 6.5 7.5 6 7.5-6"/>',
      tag: '<path d="M11.5 4h5A1.5 1.5 0 0 1 18 5.5v5a1.5 1.5 0 0 1-.44 1.06l-8 8a1.5 1.5 0 0 1-2.12 0l-4-4a1.5 1.5 0 0 1 0-2.12l8-8A1.5 1.5 0 0 1 11.5 4Z"/><circle cx="14.5" cy="8.5" r="1.1"/>',
      pencil: '<path d="M15.5 5.5 19 9 9 19H5.5v-3.5Z"/><path d="M13.5 7.5 17 11"/>',
      upload: '<path d="M12 15V4M8 8l4-4 4 4"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/>',
      plus: '<path d="M12 5v14M5 12h14"/>',
    };
    return '<svg ' + attrs + ' class="inline-block align-[-2px] shrink-0">' + (paths[name] || '') + '</svg>';
  }
  // Modal genérico: id + título + contenido HTML del <form>.
  function modal(id, titulo, formHtml){
    return '<div id="' + id + '" hidden class="fixed inset-0 z-50 flex items-center justify-center p-4">'
      + '<div class="absolute inset-0 bg-slate-900/40" onclick="document.getElementById(\'' + id + '\').hidden=true"></div>'
      + '<div class="relative bg-white rounded-xl shadow-card-hover w-full max-w-md p-5 max-h-[85vh] overflow-y-auto">'
      + '<button type="button" onclick="document.getElementById(\'' + id + '\').hidden=true" class="absolute top-3 right-3 text-slate-400 hover:text-slate-600 text-lg leading-none">&times;</button>'
      + '<h3 class="font-semibold text-slate-800 mb-3">' + titulo + '</h3>'
      + formHtml
      + '</div></div>';
  }
%>

<a href="/clientes" class="text-sm text-brand-600 hover:underline">&larr; Volver a clientes</a>

<div class="flex items-center justify-between mt-2 mb-1">
  <div class="flex items-center gap-3">
    <%- include('../partials/cliente-avatar', { id: cliente.id, nombre: cliente.nombre, logo: cliente.logo, size: 40 }) %>
    <h1 class="text-2xl font-bold text-slate-800"><%= cliente.nombre %></h1>
    <%
      var hayPotencial = unicos.some(function(u){ return u.estado === 'potencial'; });
      var estadoEfec = (cliente.estado === 'inactivo' && hayPotencial) ? 'potencial' : cliente.estado;
      var ec = estadoCliente(estadoEfec);
    %>
    <span class="text-xs font-medium px-2 py-0.5 rounded-full <%= ec[1] %>"><%= ec[0] %></span>
    <% if (estadoEfec !== cliente.estado) { %><span class="text-xs text-amber-600">(inactivo con presupuesto pendiente)</span><% } %>
  </div>
</div>

<% if (grupoDe) { %>
  <div class="mt-2 text-sm text-slate-500"><%- ic('tag') %> Pertenece al grupo <a href="/clientes/<%= grupoDe.id %>" class="text-brand-600 hover:underline font-medium"><%= grupoDe.nombre %></a></div>
<% } %>
<% if (subclientes.length) { %>
  <div class="mt-2 text-sm text-slate-500">
    <%- ic('tag') %> Grupo de:
    <% subclientes.forEach(function(s, i){ %><a href="/clientes/<%= s.id %>" class="text-brand-600 hover:underline"><%= s.nombre %></a><%= i < subclientes.length - 1 ? ', ' : '' %><% }); %>
  </div>
<% } %>

<% var _tel = String(cliente.contacto_telefono || '').replace(/[^\d+]/g, ''); %>
<% if (cliente.contacto_nombre || cliente.contacto_telefono || cliente.contacto_email) { %>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-sm text-slate-600">
    <% if (cliente.contacto_nombre) { %><span><%- ic('user') %> <%= cliente.contacto_nombre %></span><% } %>
    <% if (cliente.contacto_telefono) { %>
      <span><%- ic('phone') %> <a href="tel:<%= _tel %>" class="hover:underline"><%= cliente.contacto_telefono %></a>
        <a href="https://wa.me/<%= _tel.replace(/^\+/, '') %>" target="_blank" rel="noopener" class="text-green-600 hover:underline ml-1">WhatsApp</a></span>
    <% } %>
    <% if (cliente.contacto_email) { %><span><%- ic('mail') %> <a href="mailto:<%= cliente.contacto_email %>" class="hover:underline"><%= cliente.contacto_email %></a></span><% } %>
  </div>
<% } %>

<!-- Solapas -->
<div class="flex gap-1 bg-white rounded-xl p-1 shadow-card w-fit mt-4 mb-4">
  <button type="button" class="tab-btn btn px-3 py-1.5 text-sm rounded-lg" data-tab="resumen">Resumen</button>
  <button type="button" class="tab-btn btn px-3 py-1.5 text-sm rounded-lg" data-tab="servicios">Servicios</button>
  <button type="button" class="tab-btn btn px-3 py-1.5 text-sm rounded-lg" data-tab="datos">Datos</button>
</div>

<!-- Panel: Resumen -->
<div data-panel="resumen">
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <div class="bg-white rounded-xl shadow-card p-5">
      <div class="text-xs text-slate-500 uppercase tracking-wide">Se le cobra por mes</div>
      <div class="text-3xl font-bold text-slate-800 mt-1"><%= fmt.formatARS(mensualTotal) %></div>
    </div>
    <div class="bg-white rounded-xl shadow-card p-5">
      <div class="text-xs text-slate-500 uppercase tracking-wide">Tareas activas</div>
      <div class="text-3xl font-bold text-slate-800 mt-1"><%= tareasActivas %></div>
    </div>
    <% if (cliente.redes) { %>
      <div class="bg-white rounded-xl shadow-card p-5">
        <div class="text-xs text-slate-500 uppercase tracking-wide">Contenido</div>
        <% if (!cliente.redes_sheet_url) { %>
          <div class="text-sm text-slate-400 mt-2">Sin Sheet cargado</div>
        <% } else if (!avanceContenido || !avanceContenido.ok) { %>
          <div class="text-sm text-slate-400 mt-2">No se pudo leer el Sheet</div>
        <% } else { %>
          <%
            var semAct = avanceContenido.posteos.semanas.find(function(s){ return s.n === avanceContenido.posteos.semana_actual; });
            var falta = semAct ? Math.max(0, semAct.meta - semAct.cantidad) : 0;
          %>
          <% if (!falta) { %>
            <div class="text-2xl font-bold text-green-600 mt-1">Al día</div>
          <% } else { %>
            <div class="text-3xl font-bold text-amber-500 mt-1"><%= falta %></div>
            <div class="text-xs text-slate-400">pendiente<%= falta === 1 ? '' : 's' %> esta semana</div>
          <% } %>
        <% } %>
        <a href="/contenido/<%= cliente.id %>" class="text-xs text-brand-600 hover:underline mt-2 inline-block">Ver Contenido →</a>
      </div>
    <% } %>
  </div>

  <!-- Tareas del mes -->
  <div class="bg-white rounded-xl shadow-card p-5 mt-4">
    <h2 class="font-semibold text-slate-800 mb-3">Checklist de tareas del mes</h2>
    <% if (!tareasMes.length) { %>
      <p class="text-sm text-slate-500">No hay tareas de este cliente con vencimiento este mes.</p>
    <% } %>
    <ul class="space-y-2">
      <% tareasMes.forEach(function(t){ %>
        <li class="flex items-center gap-3">
          <form method="POST" action="/tareas/<%= t.id %>/estado" class="flex items-center">
            <input type="hidden" name="estado" value="<%= t.estado === 'completada' ? 'pendiente' : 'completada' %>" />
            <button type="submit" class="w-5 h-5 rounded border <%= t.estado === 'completada' ? 'bg-green-600 border-green-600 text-white' : 'border-slate-300' %> flex items-center justify-center text-xs">
              <%= t.estado === 'completada' ? '✓' : '' %>
            </button>
          </form>
          <a href="/tareas/<%= t.id %>" class="text-sm <%= t.estado === 'completada' ? 'line-through text-slate-400' : 'text-slate-700' %> hover:text-brand-600">
            <%= t.nombre %>
          </a>
          <span class="text-xs text-slate-400">· vence <%= fmt.formatFecha(t.fecha_cierre) %> · <%= etiquetaEstadoT(t.estado) %></span>
        </li>
      <% }); %>
    </ul>
  </div>
</div>

<!-- Panel: Servicios -->
<div data-panel="servicios" hidden>

<!-- Trabajos recurrentes -->
<div id="recurrentes" class="bg-white rounded-xl shadow-card p-5">
  <div class="flex items-center justify-between mb-1">
    <h2 class="font-semibold text-slate-800">Trabajos recurrentes (mensuales)</h2>
    <button type="button" onclick="document.getElementById('add-recurrente').hidden=!document.getElementById('add-recurrente').hidden" class="text-xs text-brand-600 hover:underline flex items-center gap-1"><%- ic('plus', 13) %> Agregar</button>
  </div>
  <p class="text-xs text-slate-400 mb-3">El pago se reinicia solo cada 1° de mes.</p>

  <% if (!recurrentes.length) { %><p class="text-sm text-slate-400 py-2">Todavía no hay trabajos recurrentes.</p><% } %>
  <div class="divide-y divide-slate-100">
    <% recurrentes.forEach(function(r){ %>
      <div class="flex flex-wrap items-center gap-3 py-3">
        <div class="flex-1 min-w-[140px]">
          <div class="flex items-center gap-2">
            <span class="font-medium text-slate-800 truncate"><%= r.nombre %></span>
            <% if (!r.activo) { %><span class="text-[10px] px-1.5 py-0.5 rounded-full bg-slate-100 text-slate-500">Inactivo</span><% } %>
          </div>
          <div class="text-xs text-slate-400">Día <%= r.dia_de_cobro || '—' %> · Desde <%= r.desde || '—' %></div>
        </div>
        <div class="font-semibold text-slate-800 text-right shrink-0"><%= fmt.formatARS(r.monto_mensual) %></div>
        <form method="POST" action="/clientes/<%= cliente.id %>/recurrentes/<%= r.id %>/pago" class="shrink-0">
          <input type="hidden" name="periodo" value="<%= periodoActual %>" />
          <input type="date" name="fecha" value="<%= r.pago_fecha ? String(r.pago_fecha).slice(0,10) : '' %>" onchange="this.form.submit()"
                 class="rounded border <%= r.pago_fecha ? 'border-green-400 bg-green-50 text-green-800' : 'border-amber-300 bg-amber-50' %> px-2 py-1 text-xs w-32" />
        </form>
        <button type="button" onclick="document.getElementById('parcial-<%= r.id %>').hidden=!document.getElementById('parcial-<%= r.id %>').hidden" class="text-xs text-brand-600 hover:underline shrink-0">Pago parcial</button>
        <button type="button" onclick="document.getElementById('m-rec-<%= r.id %>').hidden=false" class="text-slate-400 hover:text-brand-600 p-1 shrink-0" title="Editar"><%- ic('pencil') %></button>
      </div>

      <% if (r.pagado > 0 && r.restante > 0.005) { %>
        <div class="pb-2 -mt-1 text-xs">
          <span class="text-amber-700 font-medium">Pago parcial:</span>
          <span class="text-slate-600">pagado <%= fmt.formatARS(r.pagado) %> de <%= fmt.formatARS(r.monto_mensual) %> · falta <%= fmt.formatARS(r.restante) %></span>
        </div>
      <% } %>

      <div id="parcial-<%= r.id %>" hidden class="pb-3 -mt-1 bg-slate-50 rounded-lg p-3 space-y-2">
        <% if (r.pagos.length) { %>
          <div class="space-y-1">
            <% r.pagos.forEach(function(p){ %>
              <div class="flex items-center justify-between text-xs text-slate-600">
                <span><%= fmt.formatARS(p.monto) %> · <%= fmt.formatFecha(p.fecha_pago) %><% if (p.registrado_por) { %> · <span class="text-slate-400"><%= p.registrado_por %></span><% } %></span>
                <form method="POST" action="/clientes/<%= cliente.id %>/recurrentes/<%= r.id %>/pago-parcial/<%= p.id %>/eliminar" onsubmit="return confirm('¿Eliminar este pago?')">
                  <button class="text-slate-300 hover:text-red-500">✕</button>
                </form>
              </div>
            <% }); %>
          </div>
        <% } %>
        <form method="POST" action="/clientes/<%= cliente.id %>/recurrentes/<%= r.id %>/pago-parcial" class="flex flex-wrap items-end gap-2">
          <input type="hidden" name="periodo" value="<%= periodoActual %>" />
          <div>
            <label class="block text-[10px] text-slate-400 mb-0.5">Monto</label>
            <input name="monto" type="number" step="0.01" min="0" required placeholder="<%= r.restante.toFixed(0) %>" class="w-28 rounded border border-slate-300 px-2 py-1 text-xs" />
          </div>
          <div>
            <label class="block text-[10px] text-slate-400 mb-0.5">Fecha</label>
            <input name="fecha" type="date" required value="<%= hoyISO %>" class="rounded border border-slate-300 px-2 py-1 text-xs" />
          </div>
          <button class="btn bg-brand-600 hover:bg-brand-700 text-white text-xs font-medium rounded px-3 py-1.5">Agregar pago</button>
        </form>
      </div>

      <%- modal('m-rec-' + r.id, 'Editar trabajo recurrente',
        '<form method="POST" action="/clientes/' + cliente.id + '/recurrentes/' + r.id + '" class="space-y-3" data-reparto>'
        + '<div><label class="block text-xs text-slate-500 mb-1">Nombre</label><input name="nombre" value="' + r.nombre.replace(/"/g,'&quot;') + '" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div class="grid grid-cols-2 gap-3">'
        + '<div><label class="block text-xs text-slate-500 mb-1">Monto/mes</label><input name="monto_mensual" type="number" step="0.01" value="' + r.monto_mensual + '" data-monto-campo class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /><p class="text-[10px] text-slate-400 mt-1">Rige desde este mes; los meses ya facturados no cambian.</p></div>'
        + '<div><label class="block text-xs text-slate-500 mb-1">Día de cobro</label><input name="dia_de_cobro" type="number" min="1" max="28" value="' + (r.dia_de_cobro || '') + '" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div><label class="block text-xs text-slate-500 mb-1">German $</label><input name="parte_german" type="number" step="0.01" value="' + (r.monto_mensual * r.reparto_german / 100) + '" data-parte-german class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div><label class="block text-xs text-slate-500 mb-1">Ezequiel $</label><input name="parte_ezequiel" type="number" step="0.01" value="' + (r.monto_mensual * r.reparto_ezequiel / 100) + '" data-parte-ezequiel class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div><label class="block text-xs text-slate-500 mb-1">Desde</label><input name="desde" type="month" value="' + (r.desde || '') + '" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div class="flex items-center gap-2 mt-5"><input type="checkbox" name="activo" value="1" id="act-' + r.id + '" ' + (r.activo ? 'checked' : '') + ' /><label for="act-' + r.id + '" class="text-sm text-slate-600">Activo</label></div>'
        + '</div>'
        + '<div class="flex items-center justify-between pt-2">'
        + '<button class="btn bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg px-4 py-2">Guardar</button>'
        + '<button name="_accion" value="eliminar" onclick="return confirm(\'¿Eliminar este trabajo recurrente?\')" class="text-sm text-red-600 hover:underline">Eliminar</button>'
        + '</div></form>') %>
    <% }); %>
  </div>

  <form id="add-recurrente" hidden method="POST" action="/clientes/<%= cliente.id %>/recurrentes" class="mt-3 grid sm:grid-cols-3 gap-2 border-t border-slate-100 pt-3" data-reparto>
    <input name="nombre" required placeholder="Nombre" class="rounded border border-slate-300 px-2 py-1.5 text-sm sm:col-span-3" />
    <input name="monto_mensual" type="number" step="0.01" value="0" placeholder="Monto/mes" data-monto-campo class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <input name="parte_german" type="number" step="0.01" value="0" placeholder="German $" data-parte-german class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <input name="parte_ezequiel" type="number" step="0.01" value="0" placeholder="Ezequiel $" data-parte-ezequiel class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <input name="dia_de_cobro" type="number" min="1" max="28" placeholder="Día de cobro" class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <input name="desde" type="month" value="<%= periodoActual %>" class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <button class="btn bg-slate-800 hover:bg-slate-900 text-white text-sm rounded-lg px-3 py-1.5">Agregar</button>
  </form>
</div>

<!-- Trabajos (sin cobrar) -->
<div id="unicos" class="bg-white rounded-xl shadow-card p-5 mt-4">
  <div class="flex items-center justify-between mb-1">
    <h2 class="font-semibold text-slate-800">Trabajos</h2>
    <button type="button" onclick="document.getElementById('add-trabajo').hidden=!document.getElementById('add-trabajo').hidden" class="text-xs text-brand-600 hover:underline flex items-center gap-1"><%- ic('plus', 13) %> Agregar</button>
  </div>
  <p class="text-xs text-slate-400 mb-3">Al cobrar, pasa a Cobros realizados.</p>

  <% if (!unicos.length) { %><p class="text-sm text-slate-400 py-2">Todavía no hay trabajos cargados.</p><% } %>
  <div class="divide-y divide-slate-100">
    <% unicos.forEach(function(u){ var pot = u.estado === 'potencial'; %>
      <div class="flex flex-wrap items-center gap-3 py-3">
        <div class="flex-1 min-w-[140px]">
          <div class="flex items-center gap-2">
            <span class="font-medium text-slate-800 truncate"><%= u.nombre %></span>
            <span class="text-[10px] px-1.5 py-0.5 rounded-full <%= estadoTrabajoClase(u.estado) %>"><%= pot ? 'Potencial' : 'Pendiente' %></span>
          </div>
          <div class="text-xs text-slate-400"><%= fmt.formatFecha(u.fecha) %></div>
        </div>
        <div class="font-semibold text-slate-800 text-right shrink-0"><%= fmt.formatARS(u.monto) %></div>
        <% if (!pot) { %>
          <form method="POST" action="/clientes/<%= cliente.id %>/unicos/<%= u.id %>/cobrar" class="flex items-center gap-1 shrink-0">
            <input type="date" name="fecha" value="<%= hoyISO %>" class="rounded border border-slate-200 px-1.5 py-1 text-xs w-32" />
            <button class="text-xs btn bg-green-600 hover:bg-green-700 text-white rounded-lg px-2 py-1.5 whitespace-nowrap">Cobrar</button>
          </form>
        <% } %>
        <button type="button" onclick="document.getElementById('m-uni-<%= u.id %>').hidden=false" class="text-slate-400 hover:text-brand-600 p-1 shrink-0" title="Editar"><%- ic('pencil') %></button>
      </div>
      <%- modal('m-uni-' + u.id, 'Editar trabajo',
        '<form method="POST" action="/clientes/' + cliente.id + '/unicos/' + u.id + '" class="space-y-3" data-reparto>'
        + '<div><label class="block text-xs text-slate-500 mb-1">Nombre</label><input name="nombre" value="' + u.nombre.replace(/"/g,'&quot;') + '" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div class="grid grid-cols-2 gap-3">'
        + '<div><label class="block text-xs text-slate-500 mb-1">Monto</label><input name="monto" type="number" step="0.01" value="' + u.monto + '" data-monto-campo class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div><label class="block text-xs text-slate-500 mb-1">Mes (fecha)</label><input name="fecha" type="date" value="' + String(u.fecha).slice(0,10) + '" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div><label class="block text-xs text-slate-500 mb-1">German $</label><input name="parte_german" type="number" step="0.01" value="' + (u.monto * u.reparto_german / 100) + '" data-parte-german class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div><label class="block text-xs text-slate-500 mb-1">Ezequiel $</label><input name="parte_ezequiel" type="number" step="0.01" value="' + (u.monto * u.reparto_ezequiel / 100) + '" data-parte-ezequiel class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '</div>'
        + '<div><label class="block text-xs text-slate-500 mb-1">Estado</label><select name="estado" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm">'
        + '<option value="pendiente"' + (!pot ? ' selected' : '') + '>Pendiente de cobro</option>'
        + '<option value="potencial"' + (pot ? ' selected' : '') + '>Potencial (presupuesto)</option>'
        + '</select></div>'
        + '<div class="flex items-center justify-between pt-2">'
        + '<button class="btn bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg px-4 py-2">Guardar</button>'
        + '<button name="_accion" value="eliminar" onclick="return confirm(\'¿Eliminar este trabajo?\')" class="text-sm text-red-600 hover:underline">Eliminar</button>'
        + '</div></form>'
        + '<div class="border-t border-slate-100 mt-3 pt-3">' + pasarSelect('unicos', u.id) + '</div>') %>
    <% }); %>
  </div>

  <form id="add-trabajo" hidden method="POST" action="/clientes/<%= cliente.id %>/unicos" class="mt-3 grid sm:grid-cols-3 gap-2 border-t border-slate-100 pt-3" data-reparto>
    <input name="nombre" required placeholder="Nombre" class="rounded border border-slate-300 px-2 py-1.5 text-sm sm:col-span-3" />
    <input name="monto" type="number" step="0.01" value="0" placeholder="Monto" data-monto-campo class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <input name="fecha" type="date" required value="<%= hoyISO %>" class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <select name="estado" class="rounded border border-slate-300 px-2 py-1.5 text-sm">
      <option value="pendiente">Pendiente de cobro</option>
      <option value="potencial">Potencial (presupuesto)</option>
    </select>
    <input name="parte_german" type="number" step="0.01" value="0" placeholder="German $" data-parte-german class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <input name="parte_ezequiel" type="number" step="0.01" value="0" placeholder="Ezequiel $" data-parte-ezequiel class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <button class="btn bg-slate-800 hover:bg-slate-900 text-white text-sm rounded-lg px-3 py-1.5">Agregar</button>
  </form>
</div>

<!-- Cobros realizados -->
<div id="cobros" class="bg-white rounded-xl shadow-card p-5 mt-4">
  <div class="flex items-center justify-between mb-1">
    <h2 class="font-semibold text-slate-800">Cobros realizados</h2>
    <button type="button" onclick="document.getElementById('add-cobro').hidden=!document.getElementById('add-cobro').hidden" class="text-xs text-brand-600 hover:underline flex items-center gap-1"><%- ic('plus', 13) %> Agregar</button>
  </div>
  <p class="text-xs text-slate-400 mb-3">El mes de facturación puede ser distinto al mes en que se cobró.</p>

  <% if (!cobros.length) { %><p class="text-sm text-slate-400 py-2">Todavía no hay cobros cargados.</p><% } %>
  <div class="divide-y divide-slate-100">
    <% cobros.forEach(function(co){ %>
      <div class="flex flex-wrap items-center gap-3 py-3">
        <div class="flex-1 min-w-[140px]">
          <div class="font-medium text-slate-800 truncate"><%= co.concepto %></div>
          <div class="text-xs text-slate-400">Facturado <%= fmt.formatFecha(co.fecha_trabajo) %> · Cobrado <%= fmt.formatFecha(co.fecha) %></div>
        </div>
        <div class="font-semibold text-green-700 text-right shrink-0"><%= fmt.formatARS(co.monto) %></div>
        <button type="button" onclick="document.getElementById('m-cob-<%= co.id %>').hidden=false" class="text-slate-400 hover:text-brand-600 p-1 shrink-0" title="Editar"><%- ic('pencil') %></button>
      </div>
      <%- modal('m-cob-' + co.id, 'Editar cobro',
        '<form method="POST" action="/clientes/' + cliente.id + '/cobros/' + co.id + '" class="space-y-3" data-reparto>'
        + '<div><label class="block text-xs text-slate-500 mb-1">Concepto</label><input name="nombre" value="' + co.concepto.replace(/"/g,'&quot;') + '" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div class="grid grid-cols-2 gap-3">'
        + '<div><label class="block text-xs text-slate-500 mb-1">Monto</label><input name="monto" type="number" step="0.01" value="' + co.monto + '" data-monto-campo class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div></div>'
        + '<div><label class="block text-xs text-slate-500 mb-1">Mes de facturación</label><input name="fecha_trabajo" type="date" value="' + String(co.fecha_trabajo).slice(0,10) + '" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div><label class="block text-xs text-slate-500 mb-1">Fecha de cobro</label><input name="fecha" type="date" value="' + String(co.fecha).slice(0,10) + '" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div><label class="block text-xs text-slate-500 mb-1">German $</label><input name="parte_german" type="number" step="0.01" value="' + (co.monto * co.reparto_german / 100) + '" data-parte-german class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '<div><label class="block text-xs text-slate-500 mb-1">Ezequiel $</label><input name="parte_ezequiel" type="number" step="0.01" value="' + (co.monto * co.reparto_ezequiel / 100) + '" data-parte-ezequiel class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>'
        + '</div>'
        + '<div class="flex items-center justify-between pt-2">'
        + '<button class="btn bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg px-4 py-2">Guardar</button>'
        + '<button name="_accion" value="eliminar" onclick="return confirm(\'¿Eliminar este cobro?\')" class="text-sm text-red-600 hover:underline">Eliminar</button>'
        + '</div></form>') %>
    <% }); %>
  </div>

  <form id="add-cobro" hidden method="POST" action="/clientes/<%= cliente.id %>/cobros" class="mt-3 grid sm:grid-cols-3 gap-2 border-t border-slate-100 pt-3" data-reparto>
    <input name="nombre" required placeholder="Concepto" class="rounded border border-slate-300 px-2 py-1.5 text-sm sm:col-span-3" />
    <input name="monto" type="number" step="0.01" value="0" placeholder="Monto" data-monto-campo class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <input name="fecha" type="date" required value="<%= hoyISO %>" placeholder="Fecha de cobro" class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <input name="fecha_trabajo" type="date" placeholder="Mes de facturación (opcional)" class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <input name="parte_german" type="number" step="0.01" value="0" placeholder="German $" data-parte-german class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <input name="parte_ezequiel" type="number" step="0.01" value="0" placeholder="Ezequiel $" data-parte-ezequiel class="rounded border border-slate-300 px-2 py-1.5 text-sm" />
    <button class="btn bg-slate-800 hover:bg-slate-900 text-white text-sm rounded-lg px-3 py-1.5">Agregar</button>
  </form>
</div>

<script>
  (function () {
    function wire(form) {
      var montoEl = form.querySelector('[data-monto-campo]');
      var gEl = form.querySelector('[data-parte-german]');
      var eEl = form.querySelector('[data-parte-ezequiel]');
      if (!montoEl || !gEl || !eEl) return;
      function monto() { return Number(montoEl.value) || 0; }
      gEl.addEventListener('input', function () { eEl.value = Math.max(0, Math.round((monto() - (Number(gEl.value) || 0)) * 100) / 100); });
      eEl.addEventListener('input', function () { gEl.value = Math.max(0, Math.round((monto() - (Number(eEl.value) || 0)) * 100) / 100); });
    }
    document.querySelectorAll('form[data-reparto]').forEach(wire);
  })();
</script>

</div>
<!-- /Panel: Servicios -->

<!-- Panel: Datos -->
<div data-panel="datos" hidden>

<div class="bg-white rounded-xl shadow-card p-5">
  <h2 class="font-semibold text-slate-800 mb-3">Datos del cliente</h2>

  <div class="flex items-start gap-4 mb-5">
    <%- include('../partials/cliente-avatar', { id: cliente.id, nombre: cliente.nombre, logo: cliente.logo, size: 56 }) %>
    <form method="POST" action="/clientes/<%= cliente.id %>" enctype="multipart/form-data" class="flex flex-wrap items-center gap-3">
      <label class="btn inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded-lg px-3 py-2 cursor-pointer">
        <%- ic('upload', 16) %> <%= cliente.logo ? 'Cambiar logo' : 'Subir logo' %>
        <input type="file" name="logo" accept="image/*" class="hidden" onchange="this.form.submit()" />
      </label>
      <% if (cliente.logo) { %>
        <button type="submit" formaction="/clientes/<%= cliente.id %>/logo/eliminar" formenctype="application/x-www-form-urlencoded" class="text-sm text-red-600 hover:underline">Quitar logo</button>
      <% } %>
    </form>
  </div>

  <form method="POST" action="/clientes/<%= cliente.id %>" class="grid sm:grid-cols-2 gap-3">
    <div><label class="block text-xs text-slate-500 mb-1">Nombre</label><input name="nombre" value="<%= cliente.nombre %>" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div>
      <label class="block text-xs text-slate-500 mb-1">Estado</label>
      <select name="estado" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm">
        <% ESTADOS.forEach(function(e){ %><option value="<%= e %>" <%= cliente.estado === e ? 'selected' : '' %>><%= e %></option><% }); %>
      </select>
    </div>
    <div><label class="block text-xs text-slate-500 mb-1">Responsable / contacto</label><input name="contacto_nombre" value="<%= cliente.contacto_nombre || '' %>" placeholder="Ej: Marta González" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Teléfono</label><input name="contacto_telefono" value="<%= cliente.contacto_telefono || '' %>" placeholder="Ej: +54 9 11 5555 5555" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div class="sm:col-span-2"><label class="block text-xs text-slate-500 mb-1">Email</label><input type="email" name="contacto_email" value="<%= cliente.contacto_email || '' %>" placeholder="Ej: contacto@cliente.com" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div class="sm:col-span-2">
      <label class="block text-xs text-slate-500 mb-1">Grupo (este cliente es sub-marca de…)</label>
      <select name="grupo_id" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" <%= subclientes.length ? 'disabled' : '' %>>
        <option value="">— Ninguno (es independiente) —</option>
        <% gruposDisponibles.forEach(function(g){ %><option value="<%= g.id %>" <%= cliente.grupo_id === g.id ? 'selected' : '' %>><%= g.nombre %></option><% }); %>
      </select>
      <% if (subclientes.length) { %>
        <p class="text-[11px] text-amber-600 mt-1">Ya es grupo de otros clientes, no puede pasar a depender de otro.</p>
      <% } %>
    </div>
    <div class="sm:col-span-2"><button class="text-sm btn bg-brand-600 hover:bg-brand-700 text-white rounded-lg px-4 py-1.5">Guardar</button></div>
  </form>

  <%- include('../partials/historial', { historial: historial }) %>

  <form method="POST" action="/clientes/<%= cliente.id %>/eliminar" onsubmit="return confirm('¿Eliminar el cliente y todos sus trabajos? Esta acción no se puede deshacer.')" class="mt-4">
    <button class="text-sm text-red-600 hover:underline">Eliminar cliente</button>
  </form>
</div>

</div>
<!-- /Panel: Datos -->

<script>
  (function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab-btn'));
    var panels = Array.prototype.slice.call(document.querySelectorAll('[data-panel]'));
    function activar(nombre, scrollId) {
      tabs.forEach(function (b) {
        var on = b.dataset.tab === nombre;
        b.classList.toggle('bg-brand-600', on);
        b.classList.toggle('text-white', on);
        b.classList.toggle('text-slate-600', !on);
        b.classList.toggle('hover:bg-slate-100', !on);
      });
      panels.forEach(function (p) { p.hidden = p.dataset.panel !== nombre; });
      if (scrollId) {
        var el = document.getElementById(scrollId);
        if (el) setTimeout(function () { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 60);
      }
    }
    tabs.forEach(function (b) {
      b.addEventListener('click', function () {
        activar(b.dataset.tab);
        history.replaceState(null, '', '#' + b.dataset.tab);
      });
    });

    var hash = location.hash.slice(1);
    var seccionAPanel = { recurrentes: 'servicios', unicos: 'servicios', cobros: 'servicios', servicios: 'servicios', datos: 'datos', resumen: 'resumen' };
    var inicial = seccionAPanel[hash] || 'resumen';
    activar(inicial, ['recurrentes', 'unicos', 'cobros'].indexOf(hash) >= 0 ? hash : null);

    // Cerrar modales con Escape.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('[id^="m-rec-"], [id^="m-uni-"], [id^="m-cob-"]').forEach(function (m) { m.hidden = true; });
      }
    });
  })();
</script>
