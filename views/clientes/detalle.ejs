<%
  function etiquetaEstadoT(e){ return { pendiente:'Pendiente', en_progreso:'En progreso', completada:'Completada' }[e] || e; }
  function estadoCliente(e){
    return {
      activo:    ['Activo', 'bg-green-100 text-green-700'],
      potencial: ['Potencial', 'bg-amber-100 text-amber-700'],
      inactivo:  ['Inactivo', 'bg-slate-200 text-slate-500'],
    }[e] || ['—', 'bg-slate-100 text-slate-600'];
  }
%>

<a href="/clientes" class="text-sm text-brand-600 hover:underline">&larr; Volver a clientes</a>

<div class="flex items-center justify-between mt-2 mb-1">
  <div class="flex items-center gap-3">
    <span class="w-5 h-5 rounded-full inline-block" style="background: <%= cliente.color %>"></span>
    <h1 class="text-2xl font-bold text-slate-800"><%= cliente.nombre %></h1>
    <%
      var hayPotencial = unicos.some(function(u){ return u.estado === 'potencial'; });
      var estadoEfec = (cliente.estado === 'inactivo' && hayPotencial) ? 'potencial' : cliente.estado;
      var ec = estadoCliente(estadoEfec);
    %>
    <span class="text-xs font-medium px-2 py-0.5 rounded-full <%= ec[1] %>"><%= ec[0] %></span>
    <% if (estadoEfec !== cliente.estado) { %><span class="text-xs text-amber-600">(inactivo con presupuesto pendiente)</span><% } %>
  </div>
</div>
<%- include('../partials/audit', { ultima: ultima }) %>

<!-- Resumen -->
<div class="grid sm:grid-cols-2 gap-4 mt-4">
  <div class="bg-white rounded-xl shadow-card p-5">
    <div class="text-xs text-slate-500 uppercase tracking-wide">Se le cobra por mes</div>
    <div class="text-3xl font-bold text-slate-800 mt-1"><%= fmt.formatARS(mensualTotal) %></div>
    <div class="text-xs text-slate-400 mt-1">Suma de trabajos recurrentes activos</div>
  </div>
  <div class="bg-white rounded-xl shadow-card p-5">
    <div class="text-xs text-slate-500 uppercase tracking-wide">Tareas de este mes</div>
    <div class="text-3xl font-bold text-slate-800 mt-1"><%= tareasMes.filter(function(t){return t.estado==='completada';}).length %>/<%= tareasMes.length %></div>
    <div class="text-xs text-slate-400 mt-1">Completadas / totales del mes</div>
  </div>
</div>

<!-- Tareas del mes -->
<div class="bg-white rounded-xl shadow-card p-5 mt-4">
  <h2 class="font-semibold text-slate-800 mb-3">Checklist de tareas del mes</h2>
  <% if (!tareasMes.length) { %>
    <p class="text-sm text-slate-500">No hay tareas de este cliente con vencimiento este mes.</p>
  <% } %>
  <ul class="space-y-2">
    <% tareasMes.forEach(function(t){ %>
      <li class="flex items-center gap-3">
        <form method="POST" action="/tareas/<%= t.id %>/estado" class="flex items-center">
          <input type="hidden" name="estado" value="<%= t.estado === 'completada' ? 'pendiente' : 'completada' %>" />
          <button type="submit" class="w-5 h-5 rounded border <%= t.estado === 'completada' ? 'bg-green-600 border-green-600 text-white' : 'border-slate-300' %> flex items-center justify-center text-xs">
            <%= t.estado === 'completada' ? '✓' : '' %>
          </button>
        </form>
        <a href="/tareas/<%= t.id %>" class="text-sm <%= t.estado === 'completada' ? 'line-through text-slate-400' : 'text-slate-700' %> hover:text-brand-600">
          <%= t.nombre %>
        </a>
        <span class="text-xs text-slate-400">· vence <%= fmt.formatFecha(t.fecha_cierre) %> · <%= etiquetaEstadoT(t.estado) %></span>
      </li>
    <% }); %>
  </ul>
</div>

<!-- Trabajos recurrentes -->
<div id="recurrentes" class="bg-white rounded-xl shadow-card p-5 mt-4">
  <h2 class="font-semibold text-slate-800 mb-3">Trabajos recurrentes (mensuales)</h2>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-slate-500 text-left border-b border-slate-200">
        <tr><th class="py-2 pr-2">Nombre</th><th class="py-2 px-2 text-right">Monto/mes</th><th class="py-2 px-2 text-center">German %</th><th class="py-2 px-2 text-center">Ezequiel %</th><th class="py-2 px-2 text-center">Día</th><th class="py-2 px-2 text-center">Activo</th><th></th></tr>
      </thead>
      <tbody>
        <% recurrentes.forEach(function(r){ %>
          <tr class="border-b border-slate-100">
            <form method="POST" action="/clientes/<%= cliente.id %>/recurrentes/<%= r.id %>">
              <td class="py-2 pr-2"><input name="nombre" value="<%= r.nombre %>" class="w-full rounded border border-slate-200 px-2 py-1" /></td>
              <td class="py-2 px-2"><input name="monto_mensual" type="number" step="0.01" value="<%= r.monto_mensual %>" class="w-28 rounded border border-slate-200 px-2 py-1 text-right" /></td>
              <td class="py-2 px-2 text-center"><input name="reparto_german" type="number" step="1" value="<%= r.reparto_german %>" class="w-16 rounded border border-slate-200 px-2 py-1 text-center" /></td>
              <td class="py-2 px-2 text-center"><input name="reparto_ezequiel" type="number" step="1" value="<%= r.reparto_ezequiel %>" class="w-16 rounded border border-slate-200 px-2 py-1 text-center" /></td>
              <td class="py-2 px-2 text-center"><input name="dia_de_cobro" type="number" min="1" max="28" value="<%= r.dia_de_cobro || '' %>" class="w-14 rounded border border-slate-200 px-2 py-1 text-center" /></td>
              <td class="py-2 px-2 text-center"><input name="activo" type="checkbox" value="1" <%= r.activo ? 'checked' : '' %> /></td>
              <td class="py-2 px-2 whitespace-nowrap">
                <button class="text-xs btn bg-brand-600 hover:bg-brand-700 text-white rounded px-2 py-1">Guardar</button>
                <button name="_accion" value="eliminar" onclick="return confirm('¿Eliminar este trabajo recurrente?')" class="text-xs text-red-600 hover:underline ml-1">Eliminar</button>
              </td>
            </form>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <form method="POST" action="/clientes/<%= cliente.id %>/recurrentes" class="mt-4 flex flex-wrap gap-2 items-end border-t border-slate-200 pt-4">
    <div><label class="block text-xs text-slate-500 mb-1">Nombre</label><input name="nombre" required class="rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Monto/mes</label><input name="monto_mensual" type="number" step="0.01" value="0" class="w-28 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">German %</label><input name="reparto_german" type="number" value="50" class="w-16 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Ezequiel %</label><input name="reparto_ezequiel" type="number" value="50" class="w-16 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Día cobro</label><input name="dia_de_cobro" type="number" min="1" max="28" class="w-16 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <button class="text-sm btn bg-slate-800 hover:bg-slate-900 text-white rounded px-3 py-1.5">+ Agregar</button>
  </form>
</div>

<!-- Trabajos únicos -->
<div id="unicos" class="bg-white rounded-xl shadow-card p-5 mt-4">
  <h2 class="font-semibold text-slate-800 mb-1">Trabajos de una sola vez</h2>
  <p class="text-xs text-slate-400 mb-3">Un trabajo <strong>potencial</strong> es un presupuesto sin confirmar: sólo suma en la proyección de Facturación. Al confirmarlo pasa a <strong>realizado</strong> y cuenta como facturación real.</p>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-slate-500 text-left border-b border-slate-200">
        <tr><th class="py-2 pr-2">Nombre</th><th class="py-2 px-2 text-right">Monto</th><th class="py-2 px-2">Fecha</th><th class="py-2 px-2 text-center">German %</th><th class="py-2 px-2 text-center">Ezequiel %</th><th class="py-2 px-2">Estado</th><th></th></tr>
      </thead>
      <tbody>
        <% unicos.forEach(function(u){ var pot = u.estado === 'potencial'; %>
          <tr class="border-b border-slate-100 <%= pot ? 'bg-amber-50/60' : '' %>">
            <form method="POST" action="/clientes/<%= cliente.id %>/unicos/<%= u.id %>">
              <td class="py-2 pr-2"><input name="nombre" value="<%= u.nombre %>" class="w-full rounded border border-slate-200 px-2 py-1" /></td>
              <td class="py-2 px-2"><input name="monto" type="number" step="0.01" value="<%= u.monto %>" class="w-28 rounded border border-slate-200 px-2 py-1 text-right" /></td>
              <td class="py-2 px-2"><input name="fecha" type="date" value="<%= String(u.fecha).slice(0,10) %>" class="rounded border border-slate-200 px-2 py-1" /></td>
              <td class="py-2 px-2 text-center"><input name="reparto_german" type="number" value="<%= u.reparto_german %>" class="w-16 rounded border border-slate-200 px-2 py-1 text-center" /></td>
              <td class="py-2 px-2 text-center"><input name="reparto_ezequiel" type="number" value="<%= u.reparto_ezequiel %>" class="w-16 rounded border border-slate-200 px-2 py-1 text-center" /></td>
              <td class="py-2 px-2">
                <span class="text-[11px] font-medium px-2 py-0.5 rounded-full <%= pot ? 'bg-amber-100 text-amber-700' : 'bg-green-100 text-green-700' %>"><%= pot ? 'Potencial' : 'Realizado' %></span>
              </td>
              <td class="py-2 px-2 whitespace-nowrap">
                <button class="text-xs btn bg-brand-600 hover:bg-brand-700 text-white rounded px-2 py-1">Guardar</button>
                <% if (pot) { %>
                  <button name="_accion" value="confirmar" class="text-xs btn bg-green-600 hover:bg-green-700 text-white rounded px-2 py-1 ml-1">Confirmar</button>
                <% } else { %>
                  <button name="_accion" value="volver_potencial" class="text-xs text-amber-700 hover:underline ml-1">→ Potencial</button>
                <% } %>
                <button name="_accion" value="eliminar" onclick="return confirm('¿Eliminar este trabajo?')" class="text-xs text-red-600 hover:underline ml-1">Eliminar</button>
              </td>
            </form>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <form method="POST" action="/clientes/<%= cliente.id %>/unicos" class="mt-4 flex flex-wrap gap-2 items-end border-t border-slate-200 pt-4">
    <div><label class="block text-xs text-slate-500 mb-1">Nombre</label><input name="nombre" required class="rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Monto</label><input name="monto" type="number" step="0.01" value="0" class="w-28 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Fecha</label><input name="fecha" type="date" required class="rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">German %</label><input name="reparto_german" type="number" value="50" class="w-16 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Ezequiel %</label><input name="reparto_ezequiel" type="number" value="50" class="w-16 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div>
      <label class="block text-xs text-slate-500 mb-1">Estado</label>
      <select name="estado" class="rounded border border-slate-300 px-2 py-1.5 text-sm">
        <option value="realizado">Realizado</option>
        <option value="potencial">Potencial (presupuesto)</option>
      </select>
    </div>
    <button class="text-sm btn bg-slate-800 hover:bg-slate-900 text-white rounded px-3 py-1.5">+ Agregar</button>
  </form>
</div>

<!-- Anotaciones -->
<div class="bg-white rounded-xl shadow-card p-5 mt-4">
  <h2 class="font-semibold text-slate-800 mb-3">Anotaciones importantes</h2>
  <form method="POST" action="/clientes/<%= cliente.id %>/notas">
    <textarea name="notas" rows="5" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" placeholder="Información relevante del cliente..."><%= cliente.notas %></textarea>
    <button class="mt-2 text-sm btn bg-brand-600 hover:bg-brand-700 text-white rounded px-3 py-1.5">Guardar anotaciones</button>
  </form>
</div>

<!-- Editar / eliminar cliente -->
<div class="bg-white rounded-xl shadow-card p-5 mt-4">
  <h2 class="font-semibold text-slate-800 mb-3">Datos del cliente</h2>
  <form method="POST" action="/clientes/<%= cliente.id %>" class="flex flex-wrap gap-3 items-end">
    <div><label class="block text-xs text-slate-500 mb-1">Nombre</label><input name="nombre" value="<%= cliente.nombre %>" class="rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Color</label><input type="color" name="color" value="<%= cliente.color %>" class="h-9 w-16 rounded border border-slate-300" /></div>
    <div>
      <label class="block text-xs text-slate-500 mb-1">Estado</label>
      <select name="estado" class="rounded border border-slate-300 px-2 py-1.5 text-sm">
        <% ESTADOS.forEach(function(e){ %><option value="<%= e %>" <%= cliente.estado === e ? 'selected' : '' %>><%= e %></option><% }); %>
      </select>
    </div>
    <button class="text-sm btn bg-brand-600 hover:bg-brand-700 text-white rounded px-3 py-1.5">Guardar</button>
  </form>

  <%- include('../partials/historial', { historial: historial }) %>

  <form method="POST" action="/clientes/<%= cliente.id %>/eliminar" onsubmit="return confirm('¿Eliminar el cliente y todos sus trabajos? Esta acción no se puede deshacer.')" class="mt-4">
    <button class="text-sm text-red-600 hover:underline">Eliminar cliente</button>
  </form>
</div>
