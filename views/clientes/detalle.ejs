<%
  function etiquetaEstadoT(e){ return { pendiente:'Pendiente', en_progreso:'En progreso', completada:'Completada' }[e] || e; }
  // Select "Pasar a otro cliente" (auto-submit)
  function pasarSelect(recurso, tid){
    var opts = clientesLista
      .filter(function(c){ return c.id !== cliente.id; })
      .map(function(c){ return '<option value="' + c.id + '">' + c.nombre + '</option>'; })
      .join('');
    return '<form method="POST" action="/clientes/' + cliente.id + '/' + recurso + '/' + tid + '/pasar">'
      + '<select name="cliente_destino" onchange="if(this.value)this.form.submit()" '
      + 'class="rounded border border-slate-200 px-2 py-1 text-xs max-w-[130px] text-slate-500">'
      + '<option value="">Pasar a…</option>' + opts + '</select></form>';
  }
  function estadoCliente(e){
    return {
      activo:    ['Activo', 'bg-green-100 text-green-700'],
      potencial: ['Potencial', 'bg-amber-100 text-amber-700'],
      inactivo:  ['Inactivo', 'bg-slate-200 text-slate-500'],
    }[e] || ['—', 'bg-slate-100 text-slate-600'];
  }
  function estadoTrabajoClase(e){
    return {
      pendiente: 'bg-red-100 text-red-700',
      potencial: 'bg-amber-100 text-amber-700',
    }[e] || 'bg-slate-100 text-slate-600';
  }
%>

<a href="/clientes" class="text-sm text-brand-600 hover:underline">&larr; Volver a clientes</a>

<div class="flex items-center justify-between mt-2 mb-1">
  <div class="flex items-center gap-3">
    <%- include('../partials/cliente-avatar', { id: cliente.id, nombre: cliente.nombre, logo: cliente.logo, size: 40 }) %>
    <h1 class="text-2xl font-bold text-slate-800"><%= cliente.nombre %></h1>
    <%
      var hayPotencial = unicos.some(function(u){ return u.estado === 'potencial'; });
      var estadoEfec = (cliente.estado === 'inactivo' && hayPotencial) ? 'potencial' : cliente.estado;
      var ec = estadoCliente(estadoEfec);
    %>
    <span class="text-xs font-medium px-2 py-0.5 rounded-full <%= ec[1] %>"><%= ec[0] %></span>
    <% if (estadoEfec !== cliente.estado) { %><span class="text-xs text-amber-600">(inactivo con presupuesto pendiente)</span><% } %>
  </div>
</div>
<%- include('../partials/audit', { ultima: ultima }) %>

<% if (cliente.redes) { %>
  <a href="/contenido/<%= cliente.id %>" class="inline-flex items-center gap-1.5 mt-2 text-sm text-brand-600 hover:underline">📸 Este cliente hace redes — ver en Contenido →</a>
<% } %>

<% if (grupoDe) { %>
  <div class="mt-2 text-sm text-slate-500">🏷️ Pertenece al grupo <a href="/clientes/<%= grupoDe.id %>" class="text-brand-600 hover:underline font-medium"><%= grupoDe.nombre %></a></div>
<% } %>
<% if (subclientes.length) { %>
  <div class="mt-2 text-sm text-slate-500">
    🏷️ Grupo de:
    <% subclientes.forEach(function(s, i){ %><a href="/clientes/<%= s.id %>" class="text-brand-600 hover:underline"><%= s.nombre %></a><%= i < subclientes.length - 1 ? ', ' : '' %><% }); %>
  </div>
<% } %>

<% var _tel = String(cliente.contacto_telefono || '').replace(/[^\d+]/g, ''); %>
<% if (cliente.contacto_nombre || cliente.contacto_telefono || cliente.contacto_email) { %>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-sm text-slate-600">
    <% if (cliente.contacto_nombre) { %><span>👤 <%= cliente.contacto_nombre %></span><% } %>
    <% if (cliente.contacto_telefono) { %>
      <span>📞 <a href="tel:<%= _tel %>" class="hover:underline"><%= cliente.contacto_telefono %></a>
        <a href="https://wa.me/<%= _tel.replace(/^\+/, '') %>" target="_blank" rel="noopener" class="text-green-600 hover:underline ml-1">WhatsApp</a></span>
    <% } %>
    <% if (cliente.contacto_email) { %><span>✉️ <a href="mailto:<%= cliente.contacto_email %>" class="hover:underline"><%= cliente.contacto_email %></a></span><% } %>
  </div>
<% } %>

<!-- Resumen -->
<div class="grid sm:grid-cols-2 gap-4 mt-4">
  <div class="bg-white rounded-xl shadow-card p-5">
    <div class="text-xs text-slate-500 uppercase tracking-wide">Se le cobra por mes</div>
    <div class="text-3xl font-bold text-slate-800 mt-1"><%= fmt.formatARS(mensualTotal) %></div>
    <div class="text-xs text-slate-400 mt-1">Suma de trabajos recurrentes activos</div>
  </div>
  <div class="bg-white rounded-xl shadow-card p-5">
    <div class="text-xs text-slate-500 uppercase tracking-wide">Tareas de este mes</div>
    <div class="text-3xl font-bold text-slate-800 mt-1"><%= tareasMes.filter(function(t){return t.estado==='completada';}).length %>/<%= tareasMes.length %></div>
    <div class="text-xs text-slate-400 mt-1">Completadas / totales del mes</div>
  </div>
</div>

<!-- Tareas del mes -->
<div class="bg-white rounded-xl shadow-card p-5 mt-4">
  <h2 class="font-semibold text-slate-800 mb-3">Checklist de tareas del mes</h2>
  <% if (!tareasMes.length) { %>
    <p class="text-sm text-slate-500">No hay tareas de este cliente con vencimiento este mes.</p>
  <% } %>
  <ul class="space-y-2">
    <% tareasMes.forEach(function(t){ %>
      <li class="flex items-center gap-3">
        <form method="POST" action="/tareas/<%= t.id %>/estado" class="flex items-center">
          <input type="hidden" name="estado" value="<%= t.estado === 'completada' ? 'pendiente' : 'completada' %>" />
          <button type="submit" class="w-5 h-5 rounded border <%= t.estado === 'completada' ? 'bg-green-600 border-green-600 text-white' : 'border-slate-300' %> flex items-center justify-center text-xs">
            <%= t.estado === 'completada' ? '✓' : '' %>
          </button>
        </form>
        <a href="/tareas/<%= t.id %>" class="text-sm <%= t.estado === 'completada' ? 'line-through text-slate-400' : 'text-slate-700' %> hover:text-brand-600">
          <%= t.nombre %>
        </a>
        <span class="text-xs text-slate-400">· vence <%= fmt.formatFecha(t.fecha_cierre) %> · <%= etiquetaEstadoT(t.estado) %></span>
      </li>
    <% }); %>
  </ul>
</div>

<!-- Trabajos recurrentes -->
<div id="recurrentes" class="bg-white rounded-xl shadow-card p-5 mt-4">
  <h2 class="font-semibold text-slate-800 mb-1">Trabajos recurrentes (mensuales)</h2>
  <p class="text-xs text-slate-400 mb-3">
    <strong>Día</strong> = hasta qué día del mes tiene tiempo de pagar.
    <strong>¿Pagó?</strong> = fecha real de pago de <%= fmt.nombreMes(Number(periodoActual.slice(5,7))) %> <%= periodoActual.slice(0,4) %>
    (se vacía sola el 1° de cada mes). Si está vacío, en Facturación figura <span class="text-amber-600">pendiente</span>.
  </p>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-slate-500 text-left border-b border-slate-200">
        <tr><th class="py-2 pr-2">Nombre</th><th class="py-2 px-2 text-right">Monto/mes</th><th class="py-2 px-2 text-center">German %</th><th class="py-2 px-2 text-center">Ezequiel %</th><th class="py-2 px-2 text-center">Día</th><th class="py-2 px-2 text-center">Activo</th><th></th><th class="py-2 px-2">¿Pagó? (<%= fmt.nombreMes(Number(periodoActual.slice(5,7))).slice(0,3) %>)</th><th class="py-2 px-2">Pasar</th></tr>
      </thead>
      <tbody>
        <% recurrentes.forEach(function(r){ %>
          <tr class="border-b border-slate-100">
            <form method="POST" action="/clientes/<%= cliente.id %>/recurrentes/<%= r.id %>">
              <td class="py-2 pr-2"><input name="nombre" value="<%= r.nombre %>" class="w-full rounded border border-slate-200 px-2 py-1" /></td>
              <td class="py-2 px-2"><input name="monto_mensual" type="number" step="0.01" value="<%= r.monto_mensual %>" class="w-28 rounded border border-slate-200 px-2 py-1 text-right" /></td>
              <td class="py-2 px-2 text-center"><input name="reparto_german" type="number" step="1" value="<%= r.reparto_german %>" class="w-16 rounded border border-slate-200 px-2 py-1 text-center" /></td>
              <td class="py-2 px-2 text-center"><input name="reparto_ezequiel" type="number" step="1" value="<%= r.reparto_ezequiel %>" class="w-16 rounded border border-slate-200 px-2 py-1 text-center" /></td>
              <td class="py-2 px-2 text-center"><input name="dia_de_cobro" type="number" min="1" max="28" value="<%= r.dia_de_cobro || '' %>" class="w-14 rounded border border-slate-200 px-2 py-1 text-center" /></td>
              <td class="py-2 px-2 text-center"><input name="activo" type="checkbox" value="1" <%= r.activo ? 'checked' : '' %> /></td>
              <td class="py-2 px-2 whitespace-nowrap">
                <button class="text-xs btn bg-brand-600 hover:bg-brand-700 text-white rounded px-2 py-1">Guardar</button>
                <button name="_accion" value="eliminar" onclick="return confirm('¿Eliminar este trabajo recurrente?')" class="text-xs text-red-600 hover:underline ml-1">Eliminar</button>
              </td>
            </form>
            <td class="py-2 px-2">
              <form method="POST" action="/clientes/<%= cliente.id %>/recurrentes/<%= r.id %>/pago">
                <input type="hidden" name="periodo" value="<%= periodoActual %>" />
                <input type="date" name="fecha" value="<%= r.pago_fecha ? String(r.pago_fecha).slice(0,10) : '' %>" onchange="this.form.submit()"
                       class="rounded border <%= r.pago_fecha ? 'border-green-400 bg-green-50 text-green-800' : 'border-amber-300 bg-amber-50' %> px-2 py-1 text-xs" />
              </form>
            </td>
            <td class="py-2 px-2"><%- pasarSelect('recurrentes', r.id) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="text-xs text-slate-400 mt-2">Para editar montos o repartos, cambiá los valores y tocá <kbd class="text-[10px] bg-slate-100 px-1 rounded">Enter</kbd> en el campo.</p>

  <form method="POST" action="/clientes/<%= cliente.id %>/recurrentes" class="mt-4 flex flex-wrap gap-2 items-end border-t border-slate-200 pt-4">
    <div><label class="block text-xs text-slate-500 mb-1">Nombre</label><input name="nombre" required class="rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Monto/mes</label><input name="monto_mensual" type="number" step="0.01" value="0" class="w-28 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">German %</label><input name="reparto_german" type="number" value="50" class="w-16 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Ezequiel %</label><input name="reparto_ezequiel" type="number" value="50" class="w-16 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Día cobro</label><input name="dia_de_cobro" type="number" min="1" max="28" class="w-16 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <button class="text-sm btn bg-slate-800 hover:bg-slate-900 text-white rounded px-3 py-1.5">+ Agregar</button>
  </form>
</div>

<!-- Trabajos (sin cobrar) -->
<div id="unicos" class="bg-white rounded-xl shadow-card p-5 mt-4">
  <h2 class="font-semibold text-slate-800 mb-1">Trabajos</h2>
  <p class="text-xs text-slate-400 mb-3">La <strong>fecha</strong> es el mes al que pertenece el trabajo (define el mes de Facturado). Un trabajo <strong>potencial</strong> es un presupuesto sin confirmar. Al cobrar un trabajo <strong>pendiente</strong> se le carga la fecha real de cobro y pasa a "Cobros realizados", abajo.</p>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-slate-500 text-left border-b border-slate-200">
        <tr><th class="py-2 pr-2">Nombre</th><th class="py-2 px-2 text-right">Monto</th><th class="py-2 px-2">Mes (fecha)</th><th class="py-2 px-2 text-center">German %</th><th class="py-2 px-2 text-center">Ezequiel %</th><th class="py-2 px-2">Estado</th><th></th><th class="py-2 px-2">Cobrar</th><th class="py-2 px-2">Pasar</th></tr>
      </thead>
      <tbody>
        <% unicos.forEach(function(u){ var pot = u.estado === 'potencial'; %>
          <tr class="border-b border-slate-100 <%= pot ? 'bg-amber-50/60' : 'bg-red-50/60' %>">
            <form method="POST" action="/clientes/<%= cliente.id %>/unicos/<%= u.id %>">
              <td class="py-2 pr-2"><input name="nombre" value="<%= u.nombre %>" class="w-full rounded border border-slate-200 px-2 py-1" /></td>
              <td class="py-2 px-2"><input name="monto" type="number" step="0.01" value="<%= u.monto %>" class="w-28 rounded border border-slate-200 px-2 py-1 text-right" /></td>
              <td class="py-2 px-2"><input name="fecha" type="date" value="<%= String(u.fecha).slice(0,10) %>" class="rounded border border-slate-200 px-2 py-1" /></td>
              <td class="py-2 px-2 text-center"><input name="reparto_german" type="number" value="<%= u.reparto_german %>" class="w-16 rounded border border-slate-200 px-2 py-1 text-center" /></td>
              <td class="py-2 px-2 text-center"><input name="reparto_ezequiel" type="number" value="<%= u.reparto_ezequiel %>" class="w-16 rounded border border-slate-200 px-2 py-1 text-center" /></td>
              <td class="py-2 px-2">
                <select name="estado" onchange="this.form.submit()" class="text-[11px] font-medium rounded-full px-2 py-1 border-0 cursor-pointer <%= estadoTrabajoClase(u.estado) %>">
                  <option value="potencial" <%= pot ? 'selected' : '' %>>Potencial</option>
                  <option value="pendiente" <%= !pot ? 'selected' : '' %>>Pendiente de cobro</option>
                </select>
              </td>
              <td class="py-2 px-2 whitespace-nowrap">
                <button class="text-xs btn bg-brand-600 hover:bg-brand-700 text-white rounded px-2 py-1">Guardar</button>
                <button name="_accion" value="eliminar" onclick="return confirm('¿Eliminar este trabajo?')" class="text-xs text-red-600 hover:underline ml-1">Eliminar</button>
              </td>
            </form>
            <td class="py-2 px-2">
              <% if (!pot) { %>
                <form method="POST" action="/clientes/<%= cliente.id %>/unicos/<%= u.id %>/cobrar" class="flex items-center gap-1">
                  <input type="date" name="fecha" value="<%= hoyISO %>" class="rounded border border-slate-200 px-1.5 py-1 text-xs w-32" />
                  <button class="text-xs btn bg-green-600 hover:bg-green-700 text-white rounded px-2 py-1 whitespace-nowrap">Cobrar</button>
                </form>
              <% } %>
            </td>
            <td class="py-2 px-2"><%- pasarSelect('unicos', u.id) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <form method="POST" action="/clientes/<%= cliente.id %>/unicos" class="mt-4 flex flex-wrap gap-2 items-end border-t border-slate-200 pt-4">
    <div><label class="block text-xs text-slate-500 mb-1">Nombre</label><input name="nombre" required class="rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Monto</label><input name="monto" type="number" step="0.01" value="0" class="w-28 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Mes (fecha)</label><input name="fecha" type="date" required value="<%= hoyISO %>" class="rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">German %</label><input name="reparto_german" type="number" value="50" class="w-16 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Ezequiel %</label><input name="reparto_ezequiel" type="number" value="50" class="w-16 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div>
      <label class="block text-xs text-slate-500 mb-1">Estado</label>
      <select name="estado" class="rounded border border-slate-300 px-2 py-1.5 text-sm">
        <option value="pendiente">Pendiente de cobro</option>
        <option value="potencial">Potencial (presupuesto)</option>
      </select>
    </div>
    <button class="text-sm btn bg-slate-800 hover:bg-slate-900 text-white rounded px-3 py-1.5">+ Agregar</button>
  </form>
</div>

<!-- Cobros realizados -->
<div id="cobros" class="bg-white rounded-xl shadow-card p-5 mt-4">
  <h2 class="font-semibold text-slate-800 mb-1">Cobros realizados</h2>
  <p class="text-xs text-slate-400 mb-3">Plata que ya entró. <strong>Fecha de cobro</strong> = cuándo se cobró de verdad (define el mes de Cobrado). <strong>Mes de facturación</strong> = a qué mes pertenece el trabajo (puede ser un mes distinto al del cobro).</p>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-slate-500 text-left border-b border-slate-200">
        <tr><th class="py-2 pr-2">Concepto</th><th class="py-2 px-2 text-right">Monto</th><th class="py-2 px-2">Mes de facturación</th><th class="py-2 px-2">Fecha de cobro</th><th class="py-2 px-2 text-center">German %</th><th class="py-2 px-2 text-center">Ezequiel %</th><th></th></tr>
      </thead>
      <tbody>
        <% cobros.forEach(function(co){ %>
          <tr class="border-b border-slate-100 bg-green-50/40">
            <form method="POST" action="/clientes/<%= cliente.id %>/cobros/<%= co.id %>">
              <td class="py-2 pr-2"><input name="nombre" value="<%= co.concepto %>" class="w-full rounded border border-slate-200 px-2 py-1" /></td>
              <td class="py-2 px-2"><input name="monto" type="number" step="0.01" value="<%= co.monto %>" class="w-28 rounded border border-slate-200 px-2 py-1 text-right" /></td>
              <td class="py-2 px-2"><input name="fecha_trabajo" type="date" value="<%= String(co.fecha_trabajo).slice(0,10) %>" class="rounded border border-slate-200 px-2 py-1" /></td>
              <td class="py-2 px-2"><input name="fecha" type="date" value="<%= String(co.fecha).slice(0,10) %>" class="rounded border border-slate-200 px-2 py-1" /></td>
              <td class="py-2 px-2 text-center"><input name="reparto_german" type="number" value="<%= co.reparto_german %>" class="w-16 rounded border border-slate-200 px-2 py-1 text-center" /></td>
              <td class="py-2 px-2 text-center"><input name="reparto_ezequiel" type="number" value="<%= co.reparto_ezequiel %>" class="w-16 rounded border border-slate-200 px-2 py-1 text-center" /></td>
              <td class="py-2 px-2 whitespace-nowrap">
                <button class="text-xs btn bg-brand-600 hover:bg-brand-700 text-white rounded px-2 py-1">Guardar</button>
                <button name="_accion" value="eliminar" onclick="return confirm('¿Eliminar este cobro?')" class="text-xs text-red-600 hover:underline ml-1">Eliminar</button>
              </td>
            </form>
          </tr>
        <% }); %>
        <% if (!cobros.length) { %><tr><td colspan="7" class="py-4 text-center text-slate-400">Todavía no hay cobros cargados.</td></tr><% } %>
      </tbody>
    </table>
  </div>

  <form method="POST" action="/clientes/<%= cliente.id %>/cobros" class="mt-4 flex flex-wrap gap-2 items-end border-t border-slate-200 pt-4">
    <div><label class="block text-xs text-slate-500 mb-1">Concepto</label><input name="nombre" required class="rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Monto</label><input name="monto" type="number" step="0.01" value="0" class="w-28 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Fecha de cobro</label><input name="fecha" type="date" required value="<%= hoyISO %>" class="rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Mes de facturación (opcional)</label><input name="fecha_trabajo" type="date" placeholder="= fecha de cobro" class="rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">German %</label><input name="reparto_german" type="number" value="50" class="w-16 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Ezequiel %</label><input name="reparto_ezequiel" type="number" value="50" class="w-16 rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <button class="text-sm btn bg-slate-800 hover:bg-slate-900 text-white rounded px-3 py-1.5">+ Agregar cobro</button>
  </form>
</div>

<!-- Anotaciones -->
<div class="bg-white rounded-xl shadow-card p-5 mt-4">
  <h2 class="font-semibold text-slate-800 mb-3">Anotaciones importantes</h2>
  <form method="POST" action="/clientes/<%= cliente.id %>/notas">
    <textarea name="notas" rows="5" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" placeholder="Información relevante del cliente..."><%= cliente.notas %></textarea>
    <button class="mt-2 text-sm btn bg-brand-600 hover:bg-brand-700 text-white rounded px-3 py-1.5">Guardar anotaciones</button>
  </form>
</div>

<!-- Editar / eliminar cliente -->
<div class="bg-white rounded-xl shadow-card p-5 mt-4">
  <h2 class="font-semibold text-slate-800 mb-3">Datos del cliente</h2>

  <div class="flex items-start gap-4 mb-4">
    <%- include('../partials/cliente-avatar', { id: cliente.id, nombre: cliente.nombre, logo: cliente.logo, size: 56 }) %>
    <form method="POST" action="/clientes/<%= cliente.id %>" enctype="multipart/form-data" class="flex flex-wrap gap-3 items-end">
      <div>
        <label class="block text-xs text-slate-500 mb-1"><%= cliente.logo ? 'Cambiar logo' : 'Subir logo' %></label>
        <input type="file" name="logo" accept="image/*" class="text-sm" />
      </div>
      <button class="text-sm btn bg-brand-600 hover:bg-brand-700 text-white rounded px-3 py-1.5">Guardar logo</button>
      <% if (cliente.logo) { %>
        <button type="submit" formaction="/clientes/<%= cliente.id %>/logo/eliminar" formenctype="application/x-www-form-urlencoded" class="text-sm text-red-600 hover:underline">Quitar logo</button>
      <% } %>
    </form>
  </div>

  <form method="POST" action="/clientes/<%= cliente.id %>" class="grid sm:grid-cols-2 gap-3">
    <div><label class="block text-xs text-slate-500 mb-1">Nombre</label><input name="nombre" value="<%= cliente.nombre %>" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div>
      <label class="block text-xs text-slate-500 mb-1">Estado</label>
      <select name="estado" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm">
        <% ESTADOS.forEach(function(e){ %><option value="<%= e %>" <%= cliente.estado === e ? 'selected' : '' %>><%= e %></option><% }); %>
      </select>
    </div>
    <div><label class="block text-xs text-slate-500 mb-1">Responsable / contacto</label><input name="contacto_nombre" value="<%= cliente.contacto_nombre || '' %>" placeholder="Ej: Marta González" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Teléfono</label><input name="contacto_telefono" value="<%= cliente.contacto_telefono || '' %>" placeholder="Ej: +54 9 11 5555 5555" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div class="sm:col-span-2"><label class="block text-xs text-slate-500 mb-1">Email</label><input type="email" name="contacto_email" value="<%= cliente.contacto_email || '' %>" placeholder="Ej: contacto@cliente.com" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" /></div>
    <div class="sm:col-span-2">
      <label class="block text-xs text-slate-500 mb-1">Grupo (este cliente es sub-marca de…)</label>
      <select name="grupo_id" class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm" <%= subclientes.length ? 'disabled' : '' %>>
        <option value="">— Ninguno (es independiente) —</option>
        <% gruposDisponibles.forEach(function(g){ %><option value="<%= g.id %>" <%= cliente.grupo_id === g.id ? 'selected' : '' %>><%= g.nombre %></option><% }); %>
      </select>
      <% if (subclientes.length) { %>
        <p class="text-[11px] text-amber-600 mt-1">Ya es grupo de otros clientes, no puede pasar a depender de otro.</p>
      <% } else { %>
        <p class="text-[11px] text-slate-400 mt-1">Ej: "Senko" puede pertenecer al grupo "Sistema Continuo". Sirve para elegirlo como sub-marca en Contenido.</p>
      <% } %>
    </div>
    <div class="sm:col-span-2"><button class="text-sm btn bg-brand-600 hover:bg-brand-700 text-white rounded px-4 py-1.5">Guardar</button></div>
  </form>

  <%- include('../partials/historial', { historial: historial }) %>

  <form method="POST" action="/clientes/<%= cliente.id %>/eliminar" onsubmit="return confirm('¿Eliminar el cliente y todos sus trabajos? Esta acción no se puede deshacer.')" class="mt-4">
    <button class="text-sm text-red-600 hover:underline">Eliminar cliente</button>
  </form>
</div>
