<%
  function etTipo(t){ return { historias:'Historias', reels:'Reels', posteos:'Posteos', carrusel:'Carrusel', otro:'Otro' }[t] || t; }
  function badgeEstado(e){ return { pendiente:'bg-slate-100 text-slate-600', en_progreso:'bg-blue-100 text-blue-700', completada:'bg-green-100 text-green-700' }[e] || 'bg-slate-100'; }
  function etEstado(e){ return { pendiente:'Pendiente', en_progreso:'En progreso', completada:'Completada' }[e] || e; }
  var metasSemanaGuardadas = {};
  try { metasSemanaGuardadas = cliente.redes_metas_posteos_sem ? JSON.parse(cliente.redes_metas_posteos_sem) : {}; } catch (e) { metasSemanaGuardadas = {}; }
%>

<a href="/contenido" class="text-sm text-brand-600 hover:underline">&larr; Volver a Contenido</a>

<div class="flex items-center gap-3 mt-2 mb-4">
  <%- include('../partials/cliente-avatar', { id: cliente.id, nombre: cliente.nombre, logo: cliente.logo, size: 44 }) %>
  <div>
    <h1 class="text-2xl font-bold text-slate-800"><%= cliente.nombre %></h1>
    <div class="text-sm text-slate-500"><%= cliente.redes_plan || 'Sin plan cargado' %></div>
  </div>
</div>

<!-- Plan y planificación -->
<div class="bg-white rounded-xl shadow-card p-4 sm:p-5 mb-4">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <div class="text-xs text-slate-500 uppercase tracking-wide">Planificación de contenido</div>
      <% if (cliente.redes_sheet_url) { %>
        <a href="<%= cliente.redes_sheet_url %>" target="_blank" rel="noopener"
           class="btn inline-flex items-center gap-2 mt-1 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg px-4 py-2">
          📄 Abrir Google Sheet
        </a>
      <% } else { %>
        <div class="text-sm text-slate-400 mt-1">Todavía no se cargó el link del Google Sheet.</div>
      <% } %>
    </div>
  </div>

  <% if (esAdmin) { %>
    <details class="mt-4 border-t border-slate-100 pt-3">
      <summary class="text-sm text-brand-600 cursor-pointer">Editar plan y link (admin)</summary>
      <form method="POST" action="/contenido/<%= cliente.id %>/config" class="mt-3 space-y-3">
        <div class="grid sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-500 mb-1">Plan</label>
            <input name="redes_plan" value="<%= cliente.redes_plan || '' %>" placeholder="Ej: Plan 1, Plan 2, A medida"
                   class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-xs text-slate-500 mb-1">Link del Google Sheet</label>
            <input name="redes_sheet_url" type="url" value="<%= cliente.redes_sheet_url || '' %>" placeholder="https://docs.google.com/…"
                   class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-xs text-slate-500 mb-1">Meta de posteos / semana (default)</label>
            <input name="redes_meta_posteos_sem" type="number" min="0" value="<%= cliente.redes_meta_posteos_sem || '' %>" placeholder="<%= DEFAULT_META_POSTEOS_SEM %> (default)"
                   class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
            <p class="text-[11px] text-slate-400 mt-1">Se usa en las semanas que no tengan una meta propia abajo.</p>
          </div>
          <div>
            <label class="block text-xs text-slate-500 mb-1">Meta de historias / mes</label>
            <input name="redes_meta_historias_mes" type="number" min="0" value="<%= cliente.redes_meta_historias_mes || '' %>" placeholder="<%= DEFAULT_META_HISTORIAS_MES %> (default)"
                   class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-xs text-slate-500 mb-1">Meta de posteos por semana del mes (opcional)</label>
          <div class="grid grid-cols-5 gap-2">
            <% for (var _n = 1; _n <= 5; _n++) { %>
              <div>
                <label class="block text-[10px] text-slate-400 mb-0.5 text-center">Semana <%= _n %></label>
                <input name="meta_sem_<%= _n %>" type="number" min="0" value="<%= metasSemanaGuardadas[_n] || '' %>" placeholder="-"
                       class="w-full rounded-lg border border-slate-300 px-2 py-2 text-sm text-center" />
              </div>
            <% } %>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <button class="btn bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg px-4 py-2">Guardar</button>
          <button name="_accion" value="quitar" onclick="return confirm('¿Quitar este cliente del módulo de contenido? No borra sus tareas de contenido.')"
                  class="text-sm text-red-600 hover:underline">Quitar de Contenido</button>
        </div>
      </form>
    </details>
  <% } %>
</div>

<!-- Avance de contenido (leído del Sheet) -->
<% if (cliente.redes_sheet_url) { %>
  <div class="bg-white rounded-xl shadow-card p-4 sm:p-5 mb-4">
    <div class="text-xs text-slate-500 uppercase tracking-wide mb-3">Avance del mes (según el Sheet)</div>
    <% if (!avance) { %>
      <p class="text-sm text-slate-400">Cargando…</p>
    <% } else if (!avance.ok) { %>
      <p class="text-sm text-red-600"><%= avance.error %></p>
    <% } else { %>
      <% var semAct = avance.posteos.semanas.find(function(s){ return s.n === avance.posteos.semana_actual; }); %>
      <div class="flex flex-wrap gap-6 items-start">
        <%- include('../partials/anillo-progreso', {
          pct: semAct ? Math.min(100, Math.round(semAct.cantidad / semAct.meta * 100)) : 0,
          label: 'Posteos · Semana ' + avance.posteos.semana_actual,
          sub: (semAct ? semAct.cantidad : 0) + '/' + (semAct ? semAct.meta : '-'),
        }) %>
        <%- include('../partials/anillo-progreso', {
          pct: avance.historias.pct,
          label: 'Historias del mes',
          sub: avance.historias.cantidad + '/' + avance.historias.meta_mes,
        }) %>
        <div class="flex-1 min-w-[180px]">
          <div class="text-xs text-slate-500 mb-1.5">Posteos por semana este mes</div>
          <div class="space-y-1">
            <% avance.posteos.semanas.forEach(function(s){ %>
              <div class="flex items-center gap-2 text-xs">
                <span class="w-24 text-slate-500 shrink-0">Semana <%= s.n %> (<%= s.desde %>-<%= s.hasta %>)</span>
                <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                  <div class="h-full rounded-full" style="width:<%= Math.min(100, Math.round(s.cantidad / s.meta * 100)) %>%; background:<%= s.n === avance.posteos.semana_actual ? '#2563eb' : '#94a3b8' %>"></div>
                </div>
                <span class="w-14 text-right text-slate-600 font-medium"><%= s.cantidad %>/<%= s.meta %></span>
              </div>
            <% }); %>
          </div>
          <p class="text-[11px] text-slate-400 mt-2">Total del mes: <%= avance.posteos.total_mes %> posteo(s).</p>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

<!-- Nueva tarea de contenido -->
<div class="bg-white rounded-xl shadow-card p-4 sm:p-5 mb-4">
  <h2 class="font-semibold text-slate-800 mb-3">Nueva tarea de contenido</h2>
  <form method="POST" action="/contenido/<%= cliente.id %>/tareas" class="space-y-3">
    <div class="grid sm:grid-cols-[1fr_auto_auto] gap-2 items-end">
      <div>
        <label class="block text-xs text-slate-500 mb-1">Título</label>
        <input name="titulo" required placeholder="Ej: Historias semana 37" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-xs text-slate-500 mb-1">Tipo</label>
        <select name="tipo" class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
          <% TIPOS.forEach(function(t){ %><option value="<%= t %>"><%= etTipo(t) %></option><% }); %>
        </select>
      </div>
      <div>
        <label class="block text-xs text-slate-500 mb-1">Fecha (opcional)</label>
        <input type="date" name="fecha_objetivo" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
      </div>
    </div>
    <div>
      <label class="block text-xs text-slate-500 mb-1">Asignar a</label>
      <div class="flex flex-wrap gap-2">
        <% users.forEach(function(u){ %>
          <label class="flex items-center gap-1.5 text-sm rounded-lg border border-slate-300 px-2.5 py-1 cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
            <input type="checkbox" name="asignados" value="<%= u.id %>" class="w-4 h-4" /><%= u.nombre %>
          </label>
        <% }); %>
      </div>
    </div>
    <button class="btn bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg px-4 py-2">Crear</button>
  </form>
</div>

<!-- Lista de tareas de contenido -->
<% if (!tareas.length) { %>
  <div class="bg-white rounded-xl shadow-card p-8 text-center text-slate-500">Todavía no hay tareas de contenido.</div>
<% } %>
<div class="space-y-2">
  <% tareas.forEach(function(t){ %>
    <a href="/contenido/<%= cliente.id %>/tareas/<%= t.id %>" class="lift block bg-white rounded-xl shadow-card hover:shadow-card-hover p-4 <%= t.estado === 'completada' ? 'opacity-70' : '' %>">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="font-semibold text-slate-800"><%= t.titulo %></span>
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-brand-50 text-brand-700"><%= etTipo(t.tipo) %></span>
            <span class="text-[11px] px-2 py-0.5 rounded-full <%= badgeEstado(t.estado) %>"><%= etEstado(t.estado) %></span>
          </div>
          <div class="text-xs text-slate-400 mt-1">
            <%= t.links_hechos %>/<%= t.links_total %> links realizados
            <% if (t.fecha_objetivo) { %> · <%= fmt.formatFecha(t.fecha_objetivo) %><% } %>
          </div>
          <% if (t.asignados && t.asignados.length) { %>
            <div class="flex gap-1 mt-1.5">
              <% t.asignados.forEach(function(a){ %><span class="text-[10px] bg-brand-100 text-brand-700 rounded-full px-1.5 py-0.5"><%= a.nombre %></span><% }); %>
            </div>
          <% } %>
        </div>
        <span class="text-slate-300 text-lg shrink-0">›</span>
      </div>
    </a>
  <% }); %>
</div>
