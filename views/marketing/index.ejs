<%- include('../partials/subnav') %>

<%
  function badgeResultado(r){
    return {
      ofrecido:'bg-blue-100 text-blue-700', esperando:'bg-amber-100 text-amber-700',
      interesado:'bg-green-100 text-green-700', rechazado:'bg-slate-200 text-slate-500',
      cerrado:'bg-emerald-600 text-white',
    }[r] || 'bg-slate-100 text-slate-600';
  }
%>

<h1 class="text-2xl font-bold text-slate-800 tracking-tight mb-1">Marketing</h1>
<p class="text-sm text-slate-500 mb-4">Clientes sin servicio activo hace tiempo + seguimiento de lo que se les ofreció.</p>

<% if (!leads.length) { %>
  <div class="bg-white rounded-xl shadow-card p-8 text-center text-slate-500">No hay clientes para re-contactar.</div>
<% } %>

<div class="grid sm:grid-cols-2 gap-4">
  <% leads.forEach(function(c){ %>
    <div id="c<%= c.id %>" class="bg-white rounded-xl shadow-card p-4 flex flex-col scroll-mt-20">
      <div class="flex items-center gap-2.5 mb-2">
        <%- include('../partials/cliente-avatar', { id: c.id, nombre: c.nombre, logo: c.logo, size: 36 }) %>
        <div class="min-w-0 flex-1">
          <a href="/clientes/<%= c.id %>" class="font-semibold text-slate-800 hover:text-brand-600 truncate block"><%= c.nombre %></a>
          <div class="flex items-center gap-1.5">
            <span class="text-[11px] px-1.5 py-0.5 rounded-full <%= c.estado === 'inactivo' ? 'bg-slate-200 text-slate-500' : (c.estado === 'potencial' ? 'bg-amber-100 text-amber-700' : 'bg-green-100 text-green-700') %>"><%= c.estado %></span>
            <% if (!c.esLead) { %><span class="text-[11px] text-slate-400">(con seguimiento)</span><% } %>
          </div>
        </div>
      </div>

      <p class="text-xs text-slate-400 mb-2">
        <% if (c.dias_sin_servicio == null) { %>Sin servicios registrados.
        <% } else if (c.dias_sin_servicio < 90) { %>Último servicio hace <%= c.dias_sin_servicio %> días.
        <% } else { %>Último servicio hace <%= Math.round(c.dias_sin_servicio / 30) %> meses.<% } %>
        <% if (c.dias_ult_contacto != null) { %>· <strong class="text-slate-600">Último contacto hace <%= c.dias_ult_contacto %> día<%= c.dias_ult_contacto === 1 ? '' : 's' %></strong><% } %>
      </p>
      <% var _t = String(c.contacto_telefono || '').replace(/[^\d+]/g, ''); %>
      <% if (c.contacto_nombre || c.contacto_telefono) { %>
        <p class="text-xs text-slate-500 mb-2">
          <% if (c.contacto_nombre) { %>👤 <%= c.contacto_nombre %><% } %>
          <% if (c.contacto_telefono) { %> · <a href="https://wa.me/<%= _t.replace(/^\+/, '') %>" target="_blank" rel="noopener" class="text-green-600 hover:underline">📞 <%= c.contacto_telefono %></a><% } %>
        </p>
      <% } %>

      <!-- Sugerencias con "ofrecer" en 1 clic -->
      <% if (c.sugerencias.length) { %>
        <div class="text-[11px] font-medium text-slate-500 uppercase tracking-wide mb-1">Qué ofrecerle</div>
        <div class="flex flex-wrap gap-1.5 mb-3">
          <% c.sugerencias.forEach(function(s){ %>
            <form method="POST" action="/marketing/<%= c.id %>/accion" style="display:contents">
              <input type="hidden" name="servicio" value="<%= s.k %>" />
              <input type="hidden" name="resultado" value="ofrecido" />
              <button title="Registrar que se lo ofrecí hoy" class="btn text-xs rounded-full px-2.5 py-1 border border-dashed <%= s.k === 'redes' ? 'border-purple-300 text-purple-700 hover:bg-purple-50' : (s.k === 'google' ? 'border-blue-300 text-blue-700 hover:bg-blue-50' : 'border-pink-300 text-pink-700 hover:bg-pink-50') %>">
                + <%= s.txt %>
              </button>
            </form>
          <% }); %>
        </div>
      <% } %>

      <!-- Historial de acciones -->
      <% if (c.acciones.length) { %>
        <div class="border-t border-slate-100 pt-2 mb-2 space-y-1.5">
          <% c.acciones.forEach(function(a){ %>
            <div class="text-xs flex items-start gap-2">
              <span class="text-slate-400 shrink-0 w-16"><%= fmt.formatFecha(a.fecha) %></span>
              <div class="flex-1 min-w-0">
                <span class="font-medium text-slate-700"><%= etiquetaServicio(a.servicio) %></span>
                <% if (a.detalle) { %><span class="text-slate-500"> — <%= a.detalle %></span><% } %>
                <div class="mt-0.5 flex items-center gap-1.5">
                  <form method="POST" action="/marketing/acciones/<%= a.id %>" style="display:contents">
                    <select name="resultado" onchange="this.form.submit()" class="text-[10px] rounded-full px-1.5 py-0.5 border-0 <%= badgeResultado(a.resultado) %>">
                      <% RESULTADOS.forEach(function(r){ %><option value="<%= r %>" <%= a.resultado === r ? 'selected' : '' %>><%= r %></option><% }); %>
                    </select>
                  </form>
                  <span class="text-slate-300">·</span>
                  <form method="POST" action="/marketing/acciones/<%= a.id %>" onsubmit="return confirm('¿Borrar esta acción?')" style="display:contents">
                    <input type="hidden" name="_accion" value="eliminar" />
                    <button class="text-[10px] text-slate-300 hover:text-red-500">borrar</button>
                  </form>
                  <span class="text-slate-300 text-[10px]"><%= a.registrado_por %></span>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <!-- Registrar contacto manual -->
      <details class="mt-auto">
        <summary class="text-xs text-brand-600 cursor-pointer">Registrar contacto / oferta</summary>
        <form method="POST" action="/marketing/<%= c.id %>/accion" class="mt-2 grid grid-cols-2 gap-2 text-sm">
          <select name="servicio" class="rounded-lg border border-slate-300 px-2 py-1.5 text-xs">
            <% SERVICIOS.forEach(function(s){ %><option value="<%= s %>"><%= etiquetaServicio(s) %></option><% }); %>
          </select>
          <input type="date" name="fecha" value="<%= hoyISO %>" class="rounded-lg border border-slate-300 px-2 py-1.5 text-xs" />
          <input name="detalle" placeholder="Nota (ej: por mail, habló con Marta)" class="col-span-2 rounded-lg border border-slate-300 px-2 py-1.5 text-xs" />
          <select name="resultado" class="rounded-lg border border-slate-300 px-2 py-1.5 text-xs">
            <% RESULTADOS.forEach(function(r){ %><option value="<%= r %>"><%= r %></option><% }); %>
          </select>
          <button class="btn bg-brand-600 hover:bg-brand-700 text-white rounded-lg px-3 py-1.5 text-xs">Registrar</button>
        </form>
      </details>

      <form method="POST" action="/marketing/<%= c.id %>/excluir" onsubmit="return confirm('¿Sacar a este cliente de Marketing? No se le va a sugerir más nada.')" class="mt-2">
        <button class="text-[11px] text-slate-400 hover:text-red-600">No ofrecer más · sacar de Marketing</button>
      </form>
    </div>
  <% }); %>
</div>

<% if (excluidos && excluidos.length) { %>
  <details class="bg-white rounded-xl shadow-card p-4 mt-6">
    <summary class="text-sm font-semibold text-slate-700 cursor-pointer">Descartados de Marketing (<%= excluidos.length %>)</summary>
    <ul class="mt-3 divide-y divide-slate-100">
      <% excluidos.forEach(function(c){ %>
        <li class="flex items-center justify-between gap-3 py-2">
          <a href="/clientes/<%= c.id %>" class="flex items-center gap-2 text-sm text-slate-600 hover:text-brand-600">
            <%- include('../partials/cliente-avatar', { id: c.id, nombre: c.nombre, logo: c.logo, size: 24 }) %><%= c.nombre %>
            <% if (c.acciones.length) { %><span class="text-xs text-slate-400">(<%= c.acciones.length %> contacto<%= c.acciones.length === 1 ? '' : 's' %>)</span><% } %>
          </a>
          <form method="POST" action="/marketing/<%= c.id %>/excluir">
            <input type="hidden" name="_accion" value="incluir" />
            <button class="text-xs text-brand-600 hover:underline">Volver a incluir</button>
          </form>
        </li>
      <% }); %>
    </ul>
  </details>
<% } %>
