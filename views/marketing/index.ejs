<%- include('../partials/subnav') %>

<%
  function badgeResultado(r){
    return {
      ofrecido:'bg-blue-100 text-blue-700', esperando:'bg-amber-100 text-amber-700',
      presupuestado:'bg-indigo-100 text-indigo-700', interesado:'bg-green-100 text-green-700',
      rechazado:'bg-slate-200 text-slate-500', cerrado:'bg-emerald-600 text-white',
    }[r] || 'bg-slate-100 text-slate-600';
  }
  function tel(t){ return String(t||'').replace(/[^\d+]/g,''); }
  function dias(n){ return n == null ? '—' : (n < 60 ? n + ' d' : Math.round(n/30) + ' m'); }
%>

<div class="flex items-center justify-between mb-3 gap-3 flex-wrap">
  <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Marketing</h1>
  <div class="flex items-center gap-2">
    <div class="flex gap-1 bg-white rounded-xl p-1 shadow-card">
      <a href="/marketing?modo=cards" class="btn px-3 py-1.5 text-sm rounded-lg <%= modo === 'cards' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-100' %>">Cards</a>
      <a href="/marketing?modo=lista" class="btn px-3 py-1.5 text-sm rounded-lg <%= modo === 'lista' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-100' %>">Lista</a>
    </div>
    <button onclick="document.getElementById('nuevo-prospecto').hidden=!document.getElementById('nuevo-prospecto').hidden" class="btn bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg px-4 py-2 shadow-sm">+ Prospecto</button>
  </div>
</div>
<p class="text-sm text-slate-500 mb-4">Clientes sin servicio activo hace tiempo + prospectos + seguimiento de re-marketing.</p>

<!-- Alta de prospecto -->
<div id="nuevo-prospecto" hidden class="bg-white rounded-xl shadow-card p-4 sm:p-5 mb-4">
  <h2 class="font-semibold text-slate-800 mb-3">Nuevo prospecto</h2>
  <form method="POST" action="/marketing/nuevo" class="grid sm:grid-cols-3 gap-3 text-sm">
    <div class="sm:col-span-3"><label class="block text-xs text-slate-500 mb-1">Nombre *</label><input name="nombre" required class="w-full rounded-lg border border-slate-300 px-3 py-2" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Responsable</label><input name="contacto_nombre" class="w-full rounded-lg border border-slate-300 px-3 py-2" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Teléfono</label><input name="contacto_telefono" class="w-full rounded-lg border border-slate-300 px-3 py-2" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Email</label><input type="email" name="contacto_email" class="w-full rounded-lg border border-slate-300 px-3 py-2" /></div>
    <div class="sm:col-span-3 border-t border-slate-100 pt-2 mt-1 text-xs text-slate-400">Opcional: si ya le presupuestaste algo</div>
    <div>
      <label class="block text-xs text-slate-500 mb-1">Servicio</label>
      <select name="servicio" class="w-full rounded-lg border border-slate-300 px-3 py-2"><% SERVICIOS.forEach(function(s){ %><option value="<%= s %>"><%= etiquetaServicio(s) %></option><% }); %></select>
    </div>
    <div><label class="block text-xs text-slate-500 mb-1">Monto presupuesto</label><input name="monto" type="number" step="0.01" placeholder="0" class="w-full rounded-lg border border-slate-300 px-3 py-2" /></div>
    <div><label class="block text-xs text-slate-500 mb-1">Nota</label><input name="detalle" class="w-full rounded-lg border border-slate-300 px-3 py-2" /></div>
    <div class="sm:col-span-3"><button class="btn bg-brand-600 hover:bg-brand-700 text-white rounded-lg px-4 py-2">Cargar prospecto</button></div>
  </form>
</div>

<% if (!leads.length) { %>
  <div class="bg-white rounded-xl shadow-card p-8 text-center text-slate-500">No hay clientes para re-contactar. Cargá un prospecto con el botón de arriba.</div>
<% } %>

<% if (modo === 'lista') { %>
  <div class="bg-white rounded-xl shadow-card overflow-x-auto">
    <table class="zebra w-full text-sm min-w-[720px]">
      <thead class="bg-slate-50 text-slate-500 text-left border-b border-slate-100">
        <tr>
          <th class="px-3 py-3 font-medium">Cliente</th>
          <th class="px-3 py-3 font-medium">Servicios que tuvo</th>
          <th class="px-3 py-3 font-medium">Contacto</th>
          <th class="px-3 py-3 font-medium">Últ. contacto</th>
          <th class="px-3 py-3 font-medium">Estado</th>
          <th class="px-3 py-3 font-medium">Re-marketing</th>
          <th class="px-3 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% leads.forEach(function(c){ %>
          <tr id="c<%= c.id %>" class="scroll-mt-20 align-top">
            <td class="px-3 py-2">
              <a href="/clientes/<%= c.id %>" class="flex items-center gap-2 font-medium text-slate-800 hover:text-brand-600">
                <%- include('../partials/cliente-avatar', { id: c.id, nombre: c.nombre, logo: c.logo, size: 20 }) %><%= c.nombre %>
              </a>
              <span class="text-[11px] text-slate-400"><%= c.estado %><% if (!c.esLead) { %> · con seguimiento<% } %></span>
            </td>
            <td class="px-3 py-2 text-slate-600 max-w-[240px]"><%= c.resumen %></td>
            <td class="px-3 py-2 text-xs text-slate-500">
              <% if (c.contacto_nombre) { %><%= c.contacto_nombre %><br><% } %>
              <% if (c.contacto_telefono) { %><a href="https://wa.me/<%= tel(c.contacto_telefono).replace(/^\+/,'') %>" target="_blank" rel="noopener" class="text-green-600">📞 <%= c.contacto_telefono %></a><% } %>
            </td>
            <td class="px-3 py-2 text-xs text-slate-500"><%= c.dias_ult_contacto != null ? 'hace ' + dias(c.dias_ult_contacto) : '—' %></td>
            <td class="px-3 py-2">
              <% if (c.resultado_actual) { %><span class="text-[11px] px-2 py-0.5 rounded-full <%= badgeResultado(c.resultado_actual) %>"><%= c.resultado_actual %></span><% } else { %><span class="text-slate-300">—</span><% } %>
            </td>
            <td class="px-3 py-2 text-xs text-slate-500">
              <% if (c.prox_recordatorio) { %>📅 <%= fmt.formatFecha(c.prox_recordatorio.fecha) %><% } else if (c.recordatorios.length) { %><%= c.recordatorios.length %> fecha(s)<% } else { %>—<% } %>
            </td>
            <td class="px-3 py-2 whitespace-nowrap text-xs">
              <a href="#c<%= c.id %>" onclick="document.getElementById('det<%= c.id %>').open=true" class="text-brand-600">Gestionar</a>
            </td>
          </tr>
          <tr class="border-b border-slate-100">
            <td colspan="7" class="px-3 pb-3">
              <details id="det<%= c.id %>"><summary class="text-xs text-brand-600 cursor-pointer">Ofrecimientos, re-marketing y acciones</summary>
                <div class="mt-2"><%- include('_gestion', { c: c }) %></div>
              </details>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="grid sm:grid-cols-2 gap-4">
    <% leads.forEach(function(c){ %>
      <div id="c<%= c.id %>" class="bg-white rounded-xl shadow-card p-4 flex flex-col scroll-mt-20">
        <div class="flex items-center gap-2.5 mb-1.5">
          <%- include('../partials/cliente-avatar', { id: c.id, nombre: c.nombre, logo: c.logo, size: 34 }) %>
          <div class="min-w-0 flex-1">
            <a href="/clientes/<%= c.id %>" class="font-semibold text-slate-800 hover:text-brand-600 truncate block"><%= c.nombre %></a>
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-[11px] px-1.5 py-0.5 rounded-full <%= c.estado === 'inactivo' ? 'bg-slate-200 text-slate-500' : (c.estado === 'potencial' ? 'bg-amber-100 text-amber-700' : 'bg-green-100 text-green-700') %>"><%= c.estado %></span>
              <% if (c.resultado_actual) { %><span class="text-[11px] px-1.5 py-0.5 rounded-full <%= badgeResultado(c.resultado_actual) %>"><%= c.resultado_actual %></span><% } %>
            </div>
          </div>
        </div>

        <p class="text-xs text-slate-600 mb-1"><%= c.resumen %></p>
        <p class="text-[11px] text-slate-400 mb-1">
          <% if (c.dias_sin_servicio == null) { %>Sin servicios.<% } else { %>Últ. servicio hace <%= dias(c.dias_sin_servicio) %>.<% } %>
          <% if (c.dias_ult_contacto != null) { %> · Últ. contacto hace <%= dias(c.dias_ult_contacto) %>.<% } %>
        </p>
        <% if (c.contacto_nombre || c.contacto_telefono) { %>
          <p class="text-xs text-slate-500 mb-1.5">
            <% if (c.contacto_nombre) { %>👤 <%= c.contacto_nombre %><% } %>
            <% if (c.contacto_telefono) { %> · <a href="https://wa.me/<%= tel(c.contacto_telefono).replace(/^\+/,'') %>" target="_blank" rel="noopener" class="text-green-600">📞 <%= c.contacto_telefono %></a><% } %>
          </p>
        <% } %>
        <% if (c.prox_recordatorio) { %>
          <p class="text-xs text-indigo-600 mb-1.5">📅 Re-marketing: <%= fmt.formatFecha(c.prox_recordatorio.fecha) %><% if (c.prox_recordatorio.nota) { %> — <%= c.prox_recordatorio.nota %><% } %></p>
        <% } %>

        <div class="mt-auto pt-1">
          <%- include('_gestion', { c: c }) %>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<% if (excluidos && excluidos.length) { %>
  <details class="bg-white rounded-xl shadow-card p-4 mt-6">
    <summary class="text-sm font-semibold text-slate-700 cursor-pointer">Descartados de Marketing (<%= excluidos.length %>)</summary>
    <ul class="mt-3 divide-y divide-slate-100">
      <% excluidos.forEach(function(c){ %>
        <li class="flex items-center justify-between gap-3 py-2">
          <a href="/clientes/<%= c.id %>" class="flex items-center gap-2 text-sm text-slate-600 hover:text-brand-600">
            <%- include('../partials/cliente-avatar', { id: c.id, nombre: c.nombre, logo: c.logo, size: 22 }) %><%= c.nombre %>
            <% if (c.acciones.length) { %><span class="text-xs text-slate-400">(<%= c.acciones.length %>)</span><% } %>
          </a>
          <form method="POST" action="/marketing/<%= c.id %>/excluir">
            <input type="hidden" name="_accion" value="incluir" />
            <button class="text-xs text-brand-600 hover:underline">Volver a incluir</button>
          </form>
        </li>
      <% }); %>
    </ul>
  </details>
<% } %>
