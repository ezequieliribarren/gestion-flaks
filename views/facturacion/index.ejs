<h1 class="text-xl sm:text-2xl font-bold text-slate-800 mb-1">Facturación</h1>
<p class="text-sm text-slate-500 mb-4"><%= fmt.nombreMes(mes) %> <%= anio %> · los montos se editan desde la ficha de cada cliente; el cobro de recurrentes se marca ahí también</p>

<%- include('../partials/periodo', { mes: mes, anio: anio, incluirPotenciales: incluirPotenciales, mostrarPotenciales: true }) %>

<% if (incluirPotenciales) { %>
  <div class="mb-3 text-xs bg-amber-100 text-amber-800 border border-amber-200 rounded px-3 py-2">
    Proyección: se incluyen ingresos de clientes potenciales que todavía no se facturan.
  </div>
<% } %>

<% if (totales.pendiente > 0) { %>
  <div class="mb-3 text-sm bg-amber-50 text-amber-800 border border-amber-200 rounded-lg px-3 py-2">
    <strong><%= fmt.formatARS(totales.pendiente) %></strong> pendientes de cobro en recurrentes este mes.
  </div>
<% } %>

<div class="bg-white rounded-xl shadow-card overflow-x-auto">
  <table class="zebra w-full text-sm min-w-[760px]">
    <thead class="bg-slate-50 text-slate-500 text-left border-b border-slate-100">
      <tr>
        <th class="px-4 py-3">Cliente</th>
        <th class="px-4 py-3">Concepto</th>
        <th class="px-4 py-3">Tipo</th>
        <th class="px-4 py-3">Cobro</th>
        <th class="px-4 py-3 text-right">Monto</th>
        <th class="px-4 py-3 text-right">German</th>
        <th class="px-4 py-3 text-right">Ezequiel</th>
      </tr>
    </thead>
    <tbody>
      <% if (!filas.length) { %>
        <tr><td colspan="7" class="px-4 py-6 text-center text-slate-500">Sin facturación para este mes.</td></tr>
      <% } %>
      <% filas.forEach(function(f){ %>
        <tr class="<%= (f.es_potencial || f.vencido) ? 'pendiente' : '' %>">
          <td class="px-4 py-3">
            <a href="/clientes/<%= f.cliente_id %>" class="flex items-center gap-2 hover:text-brand-600">
              <%- include('../partials/cliente-avatar', { id: f.cliente_id, nombre: f.cliente, logo: f.cliente_logo, size: 20 }) %><%= f.cliente %>
            </a>
          </td>
          <td class="px-4 py-3">
            <%= f.concepto %>
            <% if (f.tipo === 'unico' && f.fecha) { %><span class="text-xs text-slate-400">(<%= fmt.formatFecha(f.fecha) %>)</span><% } %>
            <% if (f.es_potencial) { %><span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-700 ml-1">potencial</span><% } %>
          </td>
          <td class="px-4 py-3"><span class="text-xs px-2 py-0.5 rounded-full <%= f.tipo === 'recurrente' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700' %>"><%= f.tipo === 'recurrente' ? 'Recurrente' : 'Único' %></span></td>
          <td class="px-4 py-3">
            <% if (f.tipo !== 'recurrente' || f.es_potencial) { %>
              <span class="text-xs text-slate-300">—</span>
            <% } else if (f.cobrado) { %>
              <span class="text-xs text-green-700">Cobrado <%= f.fecha_pago ? 'el ' + fmt.formatFecha(f.fecha_pago) : '' %></span>
            <% } else if (f.vencido) { %>
              <a href="/clientes/<%= f.cliente_id %>#recurrentes" class="text-xs font-medium text-red-600 hover:underline">⚠ Vencido<% if (f.vence_dia) { %> (día <%= f.vence_dia %>)<% } %></a>
            <% } else { %>
              <a href="/clientes/<%= f.cliente_id %>#recurrentes" class="text-xs text-amber-600 hover:underline">Pendiente<% if (f.vence_dia) { %> (hasta el <%= f.vence_dia %>)<% } %></a>
            <% } %>
          </td>
          <td class="px-4 py-3 text-right font-medium"><%= fmt.formatARS(f.monto) %></td>
          <td class="px-4 py-3 text-right text-slate-600"><%= fmt.formatARS(f.parte_german) %> <span class="text-xs text-slate-400">(<%= f.reparto_german %>%)</span></td>
          <td class="px-4 py-3 text-right text-slate-600"><%= fmt.formatARS(f.parte_ezequiel) %> <span class="text-xs text-slate-400">(<%= f.reparto_ezequiel %>%)</span></td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot class="bg-slate-50 font-semibold text-slate-800 border-t-2 border-slate-200">
      <tr>
        <td class="px-4 py-3" colspan="4">Total del mes</td>
        <td class="px-4 py-3 text-right"><%= fmt.formatARS(totales.total) %></td>
        <td class="px-4 py-3 text-right"><%= fmt.formatARS(totales.german) %></td>
        <td class="px-4 py-3 text-right"><%= fmt.formatARS(totales.ezequiel) %></td>
      </tr>
      <% if (totales.pendiente > 0) { %>
        <tr class="text-amber-800 font-medium">
          <td class="px-4 py-2" colspan="4">— de eso, pendiente de cobro (recurrentes)</td>
          <td class="px-4 py-2 text-right"><%= fmt.formatARS(totales.pendiente) %></td>
          <td colspan="2"></td>
        </tr>
      <% } %>
    </tfoot>
  </table>
</div>
