<div class="max-w-md mx-auto">
  <a href="/gastos" class="text-sm text-brand-600 hover:underline">&larr; Volver a gastos</a>
  <h1 class="text-xl sm:text-2xl font-bold text-slate-800 mt-2 mb-4">Cargar gasto</h1>

  <form id="wiz" method="POST" action="/gastos" class="bg-white rounded-xl shadow-card p-5 sm:p-6">
    <input type="hidden" name="pagado_por" id="pagado_por" value="<%= currentUserNombre %>" />
    <input type="hidden" name="fecha" id="fecha_h" value="<%= hoyISO %>" />

    <!-- indicador de pasos (solo con JS) -->
    <div id="dots" class="hidden items-center gap-1.5 mb-5" data-total="3">
      <span class="dot h-1.5 rounded-full bg-brand-600 flex-1"></span>
      <span class="dot h-1.5 rounded-full bg-slate-200 flex-1"></span>
      <span class="dot h-1.5 rounded-full bg-slate-200 flex-1"></span>
    </div>

    <!-- Paso 1: descripción -->
    <div class="step" data-step="1">
      <label class="block text-base font-medium text-slate-800 mb-2">¿Qué gasto es?</label>
      <input name="descripcion" id="descripcion" required autofocus autocomplete="off"
             placeholder="Ej: Nafta, almuerzo, publicidad…"
             class="w-full rounded-lg border border-slate-300 px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-brand-400" />
      <div class="mt-4 flex justify-end">
        <button type="button" data-next class="btn bg-brand-600 hover:bg-brand-700 text-white font-medium rounded-lg px-5 py-3 text-base">Siguiente</button>
      </div>
    </div>

    <!-- Paso 2: monto -->
    <div class="step" data-step="2">
      <label class="block text-base font-medium text-slate-800 mb-2">¿Cuánto?</label>
      <div class="relative">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-base">$</span>
        <input name="monto" id="monto" type="number" step="0.01" min="0" inputmode="decimal" required
               class="w-full rounded-lg border border-slate-300 pl-8 pr-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-brand-400" />
      </div>
      <div class="mt-4 flex justify-between">
        <button type="button" data-prev class="text-slate-500 px-3 py-3">Atrás</button>
        <button type="button" data-next class="btn bg-brand-600 hover:bg-brand-700 text-white font-medium rounded-lg px-5 py-3 text-base">Siguiente</button>
      </div>
    </div>

    <!-- Paso 3: ¿saldado? -->
    <div class="step" data-step="3">
      <label class="block text-base font-medium text-slate-800 mb-1">¿Ya está saldado?</label>
      <p class="text-xs text-slate-400 mb-3">"Saldado" = ya está pago y compensado entre los dos (pasa a Caja). Si no, va a la cuenta corriente para saldar a fin de mes.</p>
      <div class="space-y-2">
        <label class="flex items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 cursor-pointer has-[:checked]:border-green-500 has-[:checked]:bg-green-50">
          <input type="radio" name="saldado" value="1" required class="w-4 h-4" />
          <span class="text-base">Sí, ya está saldado</span>
        </label>
        <label class="flex items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 cursor-pointer has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50">
          <input type="radio" name="saldado" value="0" required class="w-4 h-4" />
          <span class="text-base">No, va a la cuenta corriente</span>
        </label>
      </div>
      <div class="mt-4 flex justify-between">
        <button type="button" data-prev class="text-slate-500 px-3 py-3">Atrás</button>
        <button type="submit" class="btn bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg px-5 py-3 text-base">Cargar gasto</button>
      </div>
    </div>

    <!-- Más opciones -->
    <details class="mt-5 border-t border-slate-100 pt-4">
      <summary class="text-sm text-brand-600 cursor-pointer">Más opciones (fecha, categoría, quién pagó)</summary>
      <div class="mt-3 space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-500 mb-1">Fecha</label>
            <input type="date" id="fecha_v" value="<%= hoyISO %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-xs text-slate-500 mb-1">Quién pagó</label>
            <select id="pagado_v" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
              <% SOCIOS.forEach(function(s){ %><option value="<%= s %>" <%= currentUserNombre === s ? 'selected' : '' %>><%= s %></option><% }); %>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs text-slate-500 mb-1">Categoría (opcional)</label>
          <input name="categoria" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" placeholder="Ej: Publicidad, Herramientas…" />
        </div>
        <label class="flex items-center gap-2 text-sm text-slate-600">
          <input type="checkbox" name="tipo" value="recurrente" class="w-4 h-4" />
          Es un gasto que se repite todos los meses
        </label>
      </div>
    </details>
  </form>
</div>

<script>
  (function () {
    var form = document.getElementById('wiz');
    if (!form) return;
    var steps = Array.prototype.slice.call(form.querySelectorAll('.step'));
    var dots = document.getElementById('dots');
    var i = 0;

    // sincronizar "Más opciones" con los inputs hidden
    var fv = document.getElementById('fecha_v'), fh = document.getElementById('fecha_h');
    var pv = document.getElementById('pagado_v'), ph = document.getElementById('pagado_por');
    if (fv && fh) fv.addEventListener('change', function () { fh.value = fv.value || fh.value; });
    if (pv && ph) pv.addEventListener('change', function () { ph.value = pv.value; });

    function show(n) {
      i = Math.max(0, Math.min(steps.length - 1, n));
      steps.forEach(function (s, idx) { s.hidden = idx !== i; });
      if (dots) Array.prototype.forEach.call(dots.querySelectorAll('.dot'), function (d, idx) {
        d.className = 'dot h-1.5 rounded-full flex-1 ' + (idx <= i ? 'bg-brand-600' : 'bg-slate-200');
      });
      var inp = steps[i].querySelector('input[name="descripcion"], input[name="monto"]');
      if (inp) setTimeout(function () { inp.focus(); }, 50);
    }

    function validStep() {
      if (i === 0) return document.getElementById('descripcion').value.trim() !== '';
      if (i === 1) return parseFloat(document.getElementById('monto').value) > 0;
      return true;
    }

    form.querySelectorAll('[data-next]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!validStep()) {
          var inp = steps[i].querySelector('input');
          if (inp) { inp.reportValidity(); inp.focus(); }
          return;
        }
        show(i + 1);
      });
    });
    form.querySelectorAll('[data-prev]').forEach(function (b) {
      b.addEventListener('click', function () { show(i - 1); });
    });

    // Enter en un input = siguiente
    form.querySelectorAll('.step input[type="text"], #descripcion, #monto').forEach(function (inp) {
      inp.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); if (validStep()) show(i + 1); }
      });
    });

    if (dots) dots.classList.remove('hidden'), dots.classList.add('flex');
    show(0);
  })();
</script>
