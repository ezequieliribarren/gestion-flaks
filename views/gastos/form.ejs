<%
  var esEdicion = !!gasto.id;
  var accion = esEdicion ? '/gastos/' + gasto.id : '/gastos';
%>
<div class="max-w-md mx-auto">
  <a href="/gastos" class="text-sm text-blue-600 hover:underline">&larr; Volver a gastos</a>
  <h1 class="text-2xl font-bold text-slate-800 mt-2 mb-4"><%= esEdicion ? 'Editar gasto' : 'Cargar gasto' %></h1>

  <form method="POST" action="<%= accion %>" class="bg-white rounded-lg shadow-sm p-6 space-y-4">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Descripción *</label>
      <input name="descripcion" required value="<%= gasto.descripcion || '' %>" class="w-full rounded-md border border-slate-300 px-3 py-2" />
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Monto *</label>
        <input name="monto" type="number" step="0.01" required value="<%= gasto.monto || 0 %>" class="w-full rounded-md border border-slate-300 px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Fecha *</label>
        <input name="fecha" type="date" required value="<%= gasto.fecha ? String(gasto.fecha).slice(0,10) : '' %>" class="w-full rounded-md border border-slate-300 px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Tipo</label>
        <select name="tipo" class="w-full rounded-md border border-slate-300 px-3 py-2">
          <% TIPOS.forEach(function(t){ %><option value="<%= t %>" <%= gasto.tipo === t ? 'selected' : '' %>><%= t === 'recurrente' ? 'Recurrente (se repite cada mes)' : 'Único' %></option><% }); %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Categoría (opcional)</label>
        <input name="categoria" value="<%= gasto.categoria || '' %>" class="w-full rounded-md border border-slate-300 px-3 py-2" />
      </div>
    </div>
    <% if (esEdicion) { %>
      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" name="activo" value="0" <%= gasto.activo ? '' : 'checked' %> />
        <span class="text-slate-600">Dar de baja este gasto recurrente (dejar de repetirlo)</span>
      </label>
    <% } %>
    <div class="flex gap-2">
      <button class="bg-blue-600 hover:bg-blue-700 text-white rounded-md px-4 py-2 text-sm"><%= esEdicion ? 'Guardar cambios' : 'Cargar gasto' %></button>
      <a href="/gastos" class="text-slate-500 hover:underline text-sm self-center">Cancelar</a>
    </div>
  </form>
</div>
