# Copiar a .env y completar. NUNCA subir el .env real al repositorio.

# Puerto local (en Hostinger lo asigna la plataforma vía process.env.PORT)
PORT=3000

# Secreto para firmar las cookies de sesión. Poné una cadena larga y aleatoria.
SESSION_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# Credenciales iniciales que crea "npm run seed" la primera vez.
GERMAN_USERNAME=german
GERMAN_PASSWORD=cambiar-esta-clave
EZEQUIEL_USERNAME=ezequiel
EZEQUIEL_PASSWORD=cambiar-esta-clave

# En producción (Hostinger) poné NODE_ENV=production para que la cookie de sesión sea segura.
NODE_ENV=development

# Carpetas de datos persistentes. En Hostinger apuntalas a una ruta ABSOLUTA fuera
# del proyecto para que el deploy por Git no borre la base ni los documentos.
# (Si las dejás vacías, usa ./data y ./storage dentro del proyecto.)
# FLAKS_DATA_DIR=/home/uXXXXXXXX/flaks-datos
# FLAKS_STORAGE_DIR=/home/uXXXXXXXX/flaks-storage

# Cargar datos de ejemplo (clientes/tareas/trabajos) al correr el seed: true | false
SEED_DEMO_DATA=true

# Porcentaje de los gastos que se le descuenta a cada socio en la Caja (0-100).
# 50 = los gastos se reparten 50/50 entre German y Ezequiel.
GASTOS_REPARTO_GERMAN=50
